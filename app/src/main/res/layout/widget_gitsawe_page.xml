<?xml version="1.0" encoding="utf-8"?>
<!--
  One transparent page inside the የዕለቱ ግጻዌ widget surface — today's readings
  or tomorrow's. The background belongs to the stationary outer layout so no
  second card peeks out behind the current page.

  Same constraints as before: plain RemoteViews-supported views only
  (LinearLayout/TextView/ImageView) — this renders in the launcher's process.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_page_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@android:color/transparent"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="11dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ስንቅ"
            android:textColor="#E4BC5A"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/widget_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="ዛሬ · ፳፪ መስከረም"
            android:textColor="#A9C1B6"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- The day's heading -->
    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:gravity="start"
        android:text="የዕለቱ ግጻዌ"
        android:textColor="#F2EDDE"
        android:textSize="15sp"
        android:textStyle="bold"
        android:lineSpacingMultiplier="1.1"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- Hairline between the heading and the readings. An ImageView, not a bare
         View: RemoteViews only inflates a fixed set of widget classes, and
         View isn't one of them. -->
    <ImageView
        android:id="@+id/widget_rule"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="7dp"
        android:contentDescription="@null"
        android:background="#5C72532F" />

    <!-- Readings: role pill + reference, the pair centred as a group -->
    <LinearLayout
        android:id="@+id/widget_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_reading_row"
        android:baselineAligned="false">

        <TextView
            android:id="@+id/widget_role_1"
            android:layout_width="54dp"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_role_chip"
            android:gravity="center"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textColor="#E4BC5A"
            android:text="ምስባክ"
            android:textSize="10sp"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widget_ref_1"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:textColor="#F2EDDE"
            android:text="መዝሙረ ዳዊት ፷፬፥፲፩–፲፪"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="5dp"
        android:background="@drawable/widget_reading_row"
        android:baselineAligned="false">

        <TextView
            android:id="@+id/widget_role_2"
            android:layout_width="54dp"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_role_chip"
            android:gravity="center"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textColor="#E4BC5A"
            android:text="ወንጌል"
            android:textSize="10sp"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widget_ref_2"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:textColor="#F2EDDE"
            android:text="የማቴዎስ ወንጌል ፲፩፥፩–፳"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- የዕለቱ ቅዳሴ — the day's anaphora, one quiet line under the readings -->
    <TextView
        android:id="@+id/widget_kidase"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="start"
        android:textColor="#9DBBAD"
        android:textSize="10sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone" />

    <!-- Shown instead of the rows when the day has no bundled reading -->
    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:textColor="#9DBBAD"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- The primary action — the whole card is tappable; this line says so. -->
    <TextView
        android:id="@+id/widget_cta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:background="@drawable/widget_footer"
        android:textColor="#E4BC5A"
        android:text="ግጻዌውን ያንብቡ  →"
        android:textStyle="bold"
        android:textSize="10sp"
        android:maxLines="1"
        android:visibility="gone" />

    <!-- Page indicator, baked into each card: the today card carries ● ○, the
         tomorrow card ○ ●, so the dots always agree with the visible page
         (a StackView never reports its position back to the provider). Hidden
         entirely when the stack has only one card. -->
    <LinearLayout
        android:id="@+id/widget_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_dot_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_page_dot"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_dot_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:text="@string/widget_page_dot"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
