<?xml version="1.0" encoding="utf-8"?>
<!--
  የዕለቱ ግጻዌ widget: one flat surface showing today's readings, rendered directly
  by GitsaweWidgetProvider (no collection service). The provider shows or hides
  the rule/rows/kidase/cta tiers to fit the size the launcher grants, so the
  same layout works from a slim strip to the full card.

  RemoteViews constraint: plain LinearLayout/TextView/ImageView only — this
  inflates in the launcher's process. Default texts double as the picker
  preview; runtime always overwrites them.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="11dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="21dp"
            android:layout_height="18dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/widget_logo"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#E4BC5A"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/widget_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="@string/widget_preview_date"
            android:textColor="#A9C1B6"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- The day's heading -->
    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:gravity="start"
        android:text="@string/widget_preview_title"
        android:textColor="#F2EDDE"
        android:textSize="15sp"
        android:textStyle="bold"
        android:lineSpacingMultiplier="1.1"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- Hairline between the heading and the readings. An ImageView, not a bare
         View: RemoteViews only inflates a fixed set of widget classes. -->
    <ImageView
        android:id="@+id/widget_rule"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="7dp"
        android:contentDescription="@null"
        android:background="#5C72532F" />

    <!-- Readings: role pill + reference -->
    <LinearLayout
        android:id="@+id/widget_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_reading_row"
        android:baselineAligned="false">

        <TextView
            android:id="@+id/widget_role_1"
            android:layout_width="54dp"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_role_chip"
            android:gravity="center"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textColor="#E4BC5A"
            android:text="@string/widget_preview_msbak"
            android:textSize="11sp"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widget_ref_1"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:textColor="#F2EDDE"
            android:text="@string/widget_preview_msbak_ref"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="5dp"
        android:background="@drawable/widget_reading_row"
        android:baselineAligned="false">

        <TextView
            android:id="@+id/widget_role_2"
            android:layout_width="54dp"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_role_chip"
            android:gravity="center"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textColor="#E4BC5A"
            android:text="@string/widget_preview_wengel"
            android:textSize="11sp"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widget_ref_2"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:textColor="#F2EDDE"
            android:text="@string/widget_preview_wengel_ref"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- የዕለቱ ቅዳሴ — the day's anaphora, one quiet line under the readings -->
    <TextView
        android:id="@+id/widget_kidase"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="start"
        android:textColor="#9DBBAD"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone" />

    <!-- Shown instead of the rows when the day has no bundled reading -->
    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:textColor="#9DBBAD"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- The primary action — the whole card is tappable; this line says so. -->
    <TextView
        android:id="@+id/widget_cta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:background="@drawable/widget_footer"
        android:textColor="#E4BC5A"
        android:text="@string/widget_preview_cta"
        android:textStyle="bold"
        android:textSize="11sp"
        android:maxLines="1"
        android:visibility="gone" />
</LinearLayout>
