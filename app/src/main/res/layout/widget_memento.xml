<?xml version="1.0" encoding="utf-8"?>
<!--
  ሞትን አስብ — the memento mori widget. One phrase, no state, nothing that
  changes: a widget that updated would be a different thing entirely.

  The Amharic is an ImageView and not a TextView on purpose. It is drawn in
  ዋልድባ (@font/waldba), and a widget layout can only name a font resource from API 26 —
  below that android:fontFamily is ignored and the line would silently fall
  back to sans on exactly the old phones the 6.0 floor was lowered for. The
  provider renders it to a bitmap with the typeface instead, which is the same
  on every API. See MementoWidgetProvider.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/memento_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/widget_background"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

    <ImageView
        android:id="@+id/memento_amharic"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:contentDescription="@string/widget_memento_label" />

    <!-- Hairline, as on the splash. An ImageView, not a bare View: RemoteViews
         only inflates a fixed set of widget classes. -->
    <ImageView
        android:id="@+id/memento_rule"
        android:layout_width="54dp"
        android:layout_height="1dp"
        android:layout_marginTop="9dp"
        android:layout_marginBottom="8dp"
        android:contentDescription="@null"
        android:background="#5C72532F" />

    <TextView
        android:id="@+id/memento_latin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_memento_latin"
        android:textColor="#A9C1B6"
        android:textSize="12sp"
        android:letterSpacing="0.10"
        android:maxLines="1" />
</LinearLayout>
