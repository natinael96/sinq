<?xml version="1.0" encoding="utf-8"?>
<!-- Deep green ground with a faint gold edge — the app's card look, and legible
     on any wallpaper (widgets sit on the launcher, not on our theme surface). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#0E3B31" />
    <stroke
        android:width="1dp"
        android:color="#1B4A3E" />
    <corners android:radius="20dp" />
</shape>
