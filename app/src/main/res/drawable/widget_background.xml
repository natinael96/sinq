<?xml version="1.0" encoding="utf-8"?>
<!-- Deep green ground with a faint gold edge — the app's card look, and legible
     on any wallpaper (widgets sit on the launcher, not on our theme surface). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#123E34"
        android:centerColor="#0E342C"
        android:endColor="#092A24" />
    <stroke
        android:width="1dp"
        android:color="#5C72532F" />
    <corners android:radius="22dp" />
</shape>
