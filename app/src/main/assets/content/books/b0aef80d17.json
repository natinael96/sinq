{"id":"b0aef80d17","title":"መልክአ አባ ጊዮርጊስ ዘጋሥጫ","shelf":"melkie","chapters":[{"number":1,"title":"","blocks":[{"type":"heading","text":"መልክአ አባ ጊዮርጊስ ዘጋሥጫ","level":1,"lang":"gez"},{"type":"heading","text":"መቅድም","level":2,"lang":"gez"},{"type":"paragraph","text":"ይትፌሣሕ ልሳንየ በጽድቀ ዚአከ ዘልፈ።","lang":"gez"},{"type":"paragraph","text":"እንዘ አየድእ ዘስብሐቲከ ተረፈ።","lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ ዘኮንከ ለኅሊና ኲሉ መጽሐፈ።","lang":"gez"},{"type":"paragraph","text":"እስመ አኀዝኩ ሐረሳዌ በገራህተ ዚአከ ዕርፈ።","lang":"gez"},{"type":"paragraph","text":"ኀጠተ ውዳሴከ ዝራዕ ዘይፈሪ እልፈ።","lang":"gez"},{"type":"paragraph","text":"ሰላም ለዝክረ ስምከ ምሉአ ጸጋ ወሞገስ።","targetAnatomy":"ዝክረ ስምከ","lang":"gez"},{"type":"paragraph","text":"ከመ ዝክረ ስሙ ዐባይ ለፀሐየ ልዳ ወፋርስ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ ዕንቊ ዘወለደከ ተርሴስ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"በጊዜ ንፍሐቱ ውስተ ገጸ ቀላይ ወየብስ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ለዘእምደቡብ ተንሥአ ነፋስ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ሰላም ለሥዕርተ ርእስከ በቅብዐ ሃይማኖት ስቁይ።","targetAnatomy":"ሥዕርተ ርእስከ","lang":"gez"},{"type":"paragraph","text":"ከመ እንተ ስኂን ምዑዝ ወከመ ቄድሮስ ኅሩይ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ ትርሲት ወማኀቶተ ዓለም ባሕርይ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"እምጸዳልከ ነጸብራቅ ወብርሃንከ ውኩይ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ኢይትፈቀድ ወርኅ ወምኑን ፀሐይ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ሰላም ለርእስከ ዘተረሰየ አክሊለ።","targetAnatomy":"ርእስከ ዘተረሰየ","lang":"gez"},{"type":"paragraph","text":"እምዕንቊ ክቡር እንተ ቦ ጸዳለ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ ዘብከ በውስተ ኲሉ ክሂለ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"አስተደሉ ለምእመናን ምሕረተ ወሣህለ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ወለዓላውያን ድምሳሴ ወኀጒለ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ሰላም ለቀራንብቲከ እለ ሐተታ ለነጽሮ።","targetAnatomy":"ቀራንብቲከ እለ","lang":"gez"},{"type":"paragraph","text":"ፍኖተ ኢየሱስ ክርስቶስ ወኲሎ ዐሠሮ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ ጥዑም አርጋኖነ ስብሐት ወዘምሮ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ድምፅከ ድምፀ ጥበብ ወክላህከ አእምሮ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"እስከ ይእዜ በውስተ ኲሉ ይደምፅ ለምህሮ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ሰላም ለአዕይንቲከ ዘዘልፈ ይጸድላ።","targetAnatomy":"አዕይንቲከ ዘዘልፈ","lang":"gez"},{"type":"paragraph","text":"እምነ ቶማስሰ ወእብላ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ ጽጌ ወመድምመ ስን ሄላ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"እንተ አሰርገውከ ለገነተ ወንጌል ማእከላ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ወመዐዛከ ነፈርአጽ ወጼናከ ተድላ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ሰላም ለአእዛኒከ እለ ዘልፈ ኮና።","targetAnatomy":"አእዛኒከ እለ","lang":"gez"},{"type":"paragraph","text":"ለቤተክርስቲያን ህየንተ እዝና።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ ሰሎሞን በዕፀ ቄድሮስ ወዕፀ ጳውቄና።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"እም አመ አቅዘዝከ ውስተ ሰማያዊት ጸቆና።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ብዙኃን ሰረቅት ኢረከቡ ፍና።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ሰላም ለመላትሒከ አፈዋተ ዘፈረያ።","targetAnatomy":"መላትሒከ አፈዋተ","lang":"gez"},{"type":"paragraph","text":"እለ ይሜስላ አምሳለ ዘዕፀ ገነት አርአያ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ መምህር ወሠላጤ መልእክት ሐዋርያ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ወአንተኬ ለባሕረ ሃይማኖት ጌልያ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ወአንተኬ ማእምር ኖትያ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ሰላም ለገጽከ ውስተ ገጸ ክርስቶስ ዘአንጸረ።","targetAnatomy":"ገጽከ ውስተ","lang":"gez"},{"type":"paragraph","text":"እንዘ ኢይትመየጥ ድኅረ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ ዘኮንከ ለቤተ ክርስቲያን ሐመረ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"በነፊሖቶሙ ሶበ ጐድኡ ባሕረ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"አቦርዮስ ወአውጣኪ ዘዐረዩ ምክረ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ሰላም ለከናፍሪከ ዘመለኮተ ይትናገራ።","targetAnatomy":"ከናፍሪከ ዘመለኮተ","lang":"gez"},{"type":"paragraph","text":"ዘኢይትረሳእ ለዝላፍ ወኢይትኃደግ ለግሙራ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ መምህር ወነቢይ ከመ ዕዝራ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ሶበ ትዘብጥ በዜማ አርጋኖነ ስብሐት መዝሙራ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ማርያም ትትፌሣሕ ወይትኃሠይ በኩራ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ሰላም ለአፉከ ዘተሰውጠ ቦቱ።","targetAnatomy":"አፉከ ዘተሰውጠ","lang":"gez"},{"type":"paragraph","text":"ለሙሴ ትንቢቱ ወለጳውሎስ ዕፍረቱ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ ብርሃን በመልዕልተ ተቅዋም ዘተኀቱ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ሶበ ኪያከ ይጼዕሉ ወመጽሐፈከ ያሰትቱ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ነአምሮሙ ለአይሁድ በዝንቱ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ሰላም ለአስናኒከ ከመ መራዕይ እለ ተቀርፃ።","targetAnatomy":"አስናኒከ ከመ","lang":"gez"},{"type":"paragraph","text":"ወእለ እምሕጻብ ሐወፃ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ መሰንቆ ለዝክርከ ቃለ ተግሣፃ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ጊዜ አንሶሰዉ በውስተ ኲሉ ወበጊዜ ተሰምዓ ድምፃ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ነገሥታተ ምድር ይሁብዋ ሞፃ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ሰላም ለአዕናፊከ እለ ይነፍሓ ለጥዒና።","targetAnatomy":"አዕናፊከ እለ","lang":"gez"},{"type":"paragraph","text":"ነፋሰ መዐዛ ወጼና።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ ዕንቊ ጥሪተ ማርያም ወሕፃና።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ዝክርከ ኃሤተ ልብ ወጣዕመ ፍቅርከ መና።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ከመ ሞገደ ባሕር ጽኑዕ የሐውክ ኅሊና።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ሰላም ለጉርዔከ ለመቅደሰ ስብሐት አንቀጹ።","targetAnatomy":"ጉርዔከ ለመቅደሰ","lang":"gez"},{"type":"paragraph","text":"መደንግፀ ክላሑ ወድምፀ ነጐድጓድ ድምፁ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ ምዑዝ ለልሳነ ዕፍረት ቢጹ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ነገሥታተ (በእንቲአከ) ምድር እለ በመዐዛከ ሮፁ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"በአእባነ ብሩር ወወርቅ ቤተከ ሐነፁ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ሰላም ለክሳድከ ሐብለ ሥላሴ አኒቆ።","targetAnatomy":"ክሳድከ ሐብለ","lang":"gez"},{"type":"paragraph","text":"ይትቀሠፍ ድኅረ ሃይማኖተ ለአጠይቆ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ ፍትው ለቤተክርስቲያን መሰንቆ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ለድምፀ በዐልከ እንዘ ይጸንሖ ተዐውቆ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"እም ዮሐንስ ባቲ ዘዘልፈ ናፍቆ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ሰላም ለመትከፍትከ እለ አንሐ ተወክፎ።","targetAnatomy":"መትከፍትከ እለ","lang":"gez"},{"type":"paragraph","text":"አርዑተ ኢየሱስ ቀሊለ ለዓለም ዘየዐርፎ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ ክሥት ለጥበብከ መጽሐፎ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ከመ ትሰብሓ ለማርያም ወከመ ለቢቱ ትዝልፎ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"እስመ ዓይነ ኵሉ ዘሥጋ ኪያከ ይሴፎ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ሰላም ለልሳንከ ልሳነ ጥበብ ወልባዌ።","targetAnatomy":"ልሳንከ ልሳነ","lang":"gez"},{"type":"paragraph","text":"ማእከለ ከናፍር ወአፍ እንተ ረሰየ ህላዌ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ መድኅን መትልወ ኢያሱ ዘነዌ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"እስከ እትቤቀሎ ለፀርየ ወለእደወ ደምየ አርዌ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ዐቅም ሊተ ፀሐየ ሥጋዌ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ሰላም ለቃልከ ከመ ቀለመ ጸሓፊ ዘሐፈጣ።","targetAnatomy":"ቃልከ ከመ","lang":"gez"},{"type":"paragraph","text":"ኆኅያተ ወንጌል ሐዳስ ወነገረ ብሉይ የውጣ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ ጴጥሮስ ወኤልሳዕ ዘትዝቤጣ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ለቃልከ ዕፍረተ ተድላ ዘእደ ኢየሱስ ፀዐጣ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ክበደ ሰማያት ወምድር ኢይከውን ሤጣ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ሰላም ለእስትንፋስከ ዘይነፍሕ ርጢነ።","targetAnatomy":"እስትንፋስከ ዘይነፍሕ","lang":"gez"},{"type":"paragraph","text":"እመንፈስ ቅዱስ ነሢኦ ሥልጣነ ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ ቀርን እንተ ትሰብክ ግዕዛነ ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ቃለ ትግሣጽከ ያጠብብ አብዳነ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ወሕገ አፉከ ይሴብሕ ጻድቃነ::","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ሰላም ለአዕዳዊከ እለ ያጸንዓ መርኆ።","targetAnatomy":"አዕዳዊከ እለ","lang":"gez"},{"type":"paragraph","text":"አንቀጽ ማኅሌት ወሰብሖ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ ጻሙ ዐሰበ ከናፍርየ ለአጽንሖ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"እመ ተከለ ኃረሣዊ በዐፀደ ወፍሩ ተጊሆ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"የኃድግኑ ለበለስ ቀሞሖ።","targetAnatomy":"ማኅሌት","lang":"amh"},{"type":"paragraph","text":"ሰላም እብል ለዘዚአከ ኲርናዕ።","targetAnatomy":"ዘዚአከ ኲርናዕ","lang":"gez"},{"type":"paragraph","text":"ስርግው በኀይል ወርሱይ በጽንዕ ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ ገነት ገነተ ተድላ ወፍግዕ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"በውሒዝከ ነፈርዓጽ ጥዒና እንስሳ ወሰብእ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ይትፌሥሑ ጥቀ መዐዝን ዘርብዕ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ሰላም ለዘባንከ እንተ ኪያሁ ለበጡ።","targetAnatomy":"ዘባንከ እንተ","lang":"gez"},{"type":"paragraph","text":"ዐጽፈ ቅድስና በላዕሉ ወልበ ንጽሕና በውስጡ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ ባሕርይ ዘዕፁብ ሤጡ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ለቁስለ ዚአየ እምርጢነ ፈውስከ መጡ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"እስመ ዘባንየ ኃጥአን ዘበጡ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ሰላም ለእንግድዓከ ዘተዐጽፈ ብርሃናተ።","targetAnatomy":"እንግድዓከ ዘተዐጽፈ","lang":"gez"},{"type":"paragraph","text":"በአብዝኆቱ ስብሐተ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ ጸሐፌ ትእዛዝ ቃላተ","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"እንዘ ታስተፋጥን አእዳዊከ ክልኤተ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ፍቁረ ማርያም ድንግል ወብፁዕ አንተ","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ሰላም ለሕፅንከ ዘረሰየቶ ምንባራ።","targetAnatomy":"ሕፅንከ ዘረሰየቶ","lang":"gez"},{"type":"paragraph","text":"ምክር ሠናይት ለኲሉ ዘይገብራ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ ቅዱስ መሥዋዕተ ስብሐት ጵርስፎራ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"በመዐዛከ ዘዘልፍ ወበጼናከ ለግሙራ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ትትፌሣሕ ጥቀ አግአዚት ደብተራ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ሰላም ለከርሥከ ዘብዕለ በርኅራኄ።","targetAnatomy":"ከርሥከ ዘብዕለ","lang":"gez"},{"type":"paragraph","text":"ወተልዐለ በይዋሄ::","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ ብርሃን የዐውደከ ሡራኄ።","targetAnatomy":"ማኅሌት","lang":"amh"},{"type":"paragraph","text":"ሥነ ጸዳልከ ጸዳለ ኢየሱስ ኤሎሄ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ዓለመ ዓለማት መልአ ወነግሠ ኵለሄ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ሰላም ለልብከ ዘኢያብደረ የኀሊ።","targetAnatomy":"ልብከ ዘኢያብደረ","lang":"gez"},{"type":"paragraph","text":"መንበርተ ዓለም ኀላፌ ወፍቶቶኒ ዘይበሊ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ ሰንቃዊ በአርአያ ዳዊት አርከ ቢርዜሊ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"በገጸ ድንግል ወበገጸ ወልዳ ከሃሊ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ምሕረተ ወፍትሐ ለውሉድከ ጸሊ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ሰላም ለእመትከ ከመ ይመጥን ዘሰፍሐ።","targetAnatomy":"እመትከ ከመ","lang":"gez"},{"type":"paragraph","text":"ለመቅደሰ ስብሐት ግድማ ወለቤተ ጸሎት ኑኃ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ ዝክርከ ሶበ ናየድዖሙ በፍሥሓ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ንፉቃነ ልብ እለ ኢየአምሩ ፍትሐ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ይጸንሱ ፃዕረ ወይወልዱ ላሐ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ሰላም ለእራኅከ እለ ስፉሐት ለውሂብ።","targetAnatomy":"እራኅከ እለ","lang":"gez"},{"type":"paragraph","text":"ሐሊበ ልቡና ወእክለ ጥበብ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ ነፋስ ሞጣሔ ተሞቅሕ ወላሕብ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ጊዜ ንፍሐትከ እምገጸ አዜብ ርሒብ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ተንሥአ ሰሜን ወመጽአ ደቡብ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ሰላም ለአፃብዒከ እንተ በዲቤሆን ሀለዋ።","targetAnatomy":"አፃብዒከ እንተ","lang":"gez"},{"type":"paragraph","text":"አጽፋረ ማኅቶት ዐሥር እለ የኀትዋ።","targetAnatomy":"ማኅሌት","lang":"amh"},{"type":"paragraph","text":"ጊዮርጊስ ጻድቅ ለጥበብ ሥርዋ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ዘስብሐት ምህርካ ወዘማኅሌት ፄዋ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"መልአከ ፍቅርከ ያስተጋብእ ነዋ ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ሰላም ለገቦከ ለሰኪብ ዘተደለወ።","targetAnatomy":"ገቦከ ለሰኪብ","lang":"gez"},{"type":"paragraph","text":"ዘቤተ መጻሕፍት ቅድወ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ ወሬዛ እንተ አርታዕከ ፍናወ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ነቢብከ ነደ እሳት አመ በዓላውያን ተክዕወ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"አፉሆሙ የብሰ ወልቦሙ በድወ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ሰላም ለአብራኪከ ለሰጊድ ዘያስተኤድማ።","targetAnatomy":"አብራኪከ ለሰጊድ","lang":"gez"},{"type":"paragraph","text":"ለክብረ ፩ዱ አምላክ በአብዝኆ ሥራኅ ወጻማ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ መምህር ወምሁረ ሕግ ፌማ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ወሰከኒ ዓመተ ተድላ እንተ ኢይትዌዳዕ ዐቅማ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"እመ ለሕይወትየ በጽሐ ወቀርበ ተፍጻማ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ሰላም ለኵልያቲከ እንተ ቦ በኑባሬ።","targetAnatomy":"ኵልያቲከ እንተ","lang":"gez"},{"type":"paragraph","text":"ሰሌዳ ሥጋ ቅድው ወመንጦላዕተ ደም ዘስዋሬ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ ካህን ምሉአ ጥበብ ወፍካሬ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ሶበ ትዘብጥ መሰንቆ ወታስተናሥዕ ዝማሬ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ያገብኡ ቃለ ደቂቁ ለቆሬ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ሰላም ለኅሊናከ አድያማተ ልብ ዘዖዳ።","targetAnatomy":"ኅሊናከ አድያማተ","lang":"gez"},{"type":"paragraph","text":"ከመ የኀልያ ጽድቀ በእንተ ማርያም ወወልዳ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ ጽሌ ወዘቃላተ ሕግ ሰሌዳ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ባርከነ ለውሉድከ ተውላጠ አምኃ ወጋዳ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"በበረከቶሙ ለሌዊ ወይሁዳ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ሰላም ለኅንብርትከ ዲበ ሰሌዳ ከርሥ ግቡር።","targetAnatomy":"ኅንብርትከ ዲበ","lang":"gez"},{"type":"paragraph","text":"ንዋያተ ውስጥ ኲሉ እንተ በውስቴቶን ዕሡር።","targetAnatomy":"ማኅሌት","lang":"amh"},{"type":"paragraph","text":"ጊዮርጊስ ቀርን ሰባኬ ሰላም ወፍቅር","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ደመና ቃልከ ጸለለ ለደብር።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ወጊሜ ሣህልከ ከደና ለባሕር።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ሰላም ለሐቌከ በቅንዓተ ሃይማኖት ቅኑት።","targetAnatomy":"ሐቌከ በቅንዓተ","lang":"gez"},{"type":"paragraph","text":"ዘማዕዘንቱ ጥበብ ወኪነ መቁጸሩ ሥርዓት።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ እግዚእ ዘምልክናከ ዕለት።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"እምሥርቀትከ ጥዒና ወሩጸትከ ሕይወት።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ደመና ኀለፈ ወጐየ ጽልመት።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ሰላም ለቆምከ ማየ መንፈስ ቅዱስ ዘአጥለሎ።","targetAnatomy":"ቆምከ ማየ","lang":"gez"},{"type":"paragraph","text":"ሠናይ ለርእይ ወአዳም ለአጽልሎ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ ስምከ እምነ ልዑላን ተልዒሎ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"በውስተ ሀገር ከመ እንተ ንጉሥ ሀሎ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"እንዘ ሥልጣኑ ያስተራትዕ ኲሎ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ሰላም ለአእጋሪከ በእብነ ኃጢአት ዘኢትአቅፋ።","targetAnatomy":"አእጋሪከ በእብነ","lang":"gez"},{"type":"paragraph","text":"ፍኖተ ኢየሱስ ክርስቶስ እስከ የኀልፋ።","targetAnatomy":"ማኅሌት","lang":"amh"},{"type":"paragraph","text":"ጊዮርጊስ ጠቢብ ለቤተ ክርስቲያን ዘትኄድፋ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"እንበለ ሕጸጽ ሰበከ ከመ ጳውሎስ ወኬፋ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"አጽናፈ ዓለም ረሰይከ ተስፋ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ሰላም ለሰኮናዊከ ዘአንሳህለለ መድረከ መኀልይ።","targetAnatomy":"ሰኮናዊከ ዘአንሳህለለ","lang":"gez"},{"type":"paragraph","text":"ወእለ ኢድኅፃ በፍኖተ ዓለም ጠዋይ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ እግዚእ ወመልአከ ሀገር ዐባይ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ኢይኀጥኡ እምዘፈቀዱ እለ ሐፀኖሙ ማይ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"አንጠብጠበ መና ቃልከ ሰማይ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ሰላም ለመከየድከ በፍኖተ መጻሕፍት ዘመረዳ።","targetAnatomy":"መከየድከ በፍኖተ","lang":"gez"},{"type":"paragraph","text":"አቅራበ ወከይሴ እንዘ ይከይዳ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ ባሕርይ ፍቁረ ማርያም ወወልዳ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ማኅበረ ቀያፋ ወሱቱፋኒሁ ለይሁዳ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ጽዕለተ ዚአከ ይትፈደዩ ፍዳ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ሰላም ለአፃብዒከ ዘአእጋሪከ ፪።","targetAnatomy":"አፃብዒከ ዘአእጋሪከ","lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ ዘኮንከ ለክርዱዳነ ልብ መስዔ። መጽንዔ ምእመናን አንተ ወዘመናፍቃን ገፍታዔ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"መጽሐፈ ሕግከ ትምክሕተ ቅድስት ጉባኤ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ለአርዮስ ወለቢቱ አጸወሙ ጉርዔ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ሰላም ለመልክእከ ዘበበገጹ ወርእየቱ።","targetAnatomy":"መልክእከ ዘበበገጹ","lang":"gez"},{"type":"paragraph","text":"ዘበበሐሳቡ ወመሌሊቱ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ ኰኵሕ ለእግዚአብሔር መሠረተ ቤቱ ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ዘኢተኃየሉ ሕንጻ ዚአከ ይንስቱ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"አናቅጸ ሲኦል አርዮስ ወቢቱ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ሰላም ለፀአተ ነፍስከ እንዘ ይማስን ኀበ ኢማሰነ።","targetAnatomy":"ፀአተ ነፍስከ","lang":"gez"},{"type":"paragraph","text":"በትእዛዘ አምላክ ዘቦቱ ሥልጣነ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ ቃልከ ቀኖተ ዓለም ዘኮነ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"በጊዜ ደጐጾ እንበለ ያስተርኢ ዐይነ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"እስከ ያስተርኢ አማዑቱ አርዮስ ፈጸነ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ሰላም እብል ለበድነ ሥጋነ ባሕርይ።","targetAnatomy":"በድነ ሥጋነ","lang":"gez"},{"type":"paragraph","text":"ማእከለ ሀገር ዘየሐቱ ከመ ሥነ ስቡሕ ፀሐይ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ ውዱስ የዐውደከ ዕበይ።","targetAnatomy":"ማኅሌት","lang":"amh"},{"type":"paragraph","text":"ለቤተ ሥጋከ ውስተ አድያሚሃ ጥዑይ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"አልቦ ሕመም ወአልቦ ድውይ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ሰላም ለግንዘተ ሥጋከ በአፈወ ዕፍረት ዘምዕዘ።","targetAnatomy":"ግንዘተ ሥጋከ","lang":"gez"},{"type":"paragraph","text":"ወልብሰ ገርዘን ብሩህ እንተ ይመስል አብያዘ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ ዖም እንተ ፈረይከ ሐዋዘ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ለማኅሌተ ስምከ እንተ ያረስእ ትካዘ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ዘያስተሐቅር በመንኖ ይመስል እንቡዘ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ሰላም ለአጽፋረ እግርከ መልዕልተ አፃብዕ ዘአስራው። ይጸድላ ዘልፈ ከመ ማኀትው።","targetAnatomy":"አጽፋረ እግርከ","lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ ራእዪ ወሐዋርያ ፍንው።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ይገንዩ ነገሥታተ ምድር በጸሎትከ ፍትው።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"እስመ ሐወዞሙ እምኲሉ አፈው።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ሰላም ለፍልሰተ ሥጋከ እምድኅረ መዋዕል ጉንዱየ። ውስተ ሙላዱ ሰግላ እንተ ኪያሃ ኀረየ።","targetAnatomy":"ፍልሰተ ሥጋከ","lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ አእምሮ እንተ ታብዕል ነዳየ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ሶበ ሰምዑ ደቂቅከ ቃለ ተናብቦ ሲሳየ።","targetAnatomy":"ማኅሌት","lang":"amh"},{"type":"paragraph","text":"አንከሩ መንክራቲከ ወርእዩ ዐቢየ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ሰላም ለመቃብሪከ ወለኲሎን አድያማ።","targetAnatomy":"መቃብሪከ ወለኲሎን","lang":"gez"},{"type":"paragraph","text":"ሰዋስወ ጸሎት ኑኃ ወምዕራገ ስብሐት ግድማ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ ማኅፈድ ወዘኢትንህል ጥቅማ","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"እምኵሎን ካልኣቲሃ ሶበ አፈድፈደት ግርማ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ደብረ ባሕርይ ሰመይዋ ስማ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ኦ ጊዮርጊስ ለእምነትየ ርድኦ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"በከመ ዕበይከ አኮ ዘአብፃዕኩከ አብጽዖ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"በብዝኃ ኂሩትከ አላ ተወከፈኒ እግዚኦ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"እመ ተቀንየ ለሊቁ በአምጣነ ኃይሉ ጠቢኦ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"መኑ ውእቱ ዘያቴክዝ ረድኦ ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ሰላም ታ","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ዓምደ ኢትዮጵያ አንተ ከመ ለምድረ ግብጽ ዓምዳ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ናስምክ ብከ ለመርዓት ዉሉዳ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ ቢጸ ሲኖዳ።","targetAnatomy":"ማኅሌት","lang":"amh"},{"type":"paragraph","text":"ሰላም ለከ ዕበያቲከ እዜኑ አፈ ወርቅ መምህር።","targetAnatomy":"ከ ዕበያቲከ","lang":"gez"},{"type":"paragraph","text":"ልስሐተ ልሳንየ ቅስም በጥዑም ነገር።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ አፈ ሶከር።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ሰላም ለከ ኖላዌ ክርስቲያን አእላፍ።","targetAnatomy":"ከ ኖላዌ","lang":"gez"},{"type":"paragraph","text":"ወክበበ አርባዕቱ አጽናፍ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"አርእስተ ረሲኣን ዘትመትር በቃለ መጽሐፍ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ ልሳነ ሰይፍ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ሰላም ለከ ፍቅረ ማርያም ትኄይስ ለአሮን እሰርጉ።","targetAnatomy":"ከ ፍቅረ","lang":"gez"},{"type":"paragraph","text":"ሊቀ ካህናት ዐቢይ ለክርስቶስ ዘውጉ፣","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ መጋቤ ሕጉ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ሰላም ለከ እንበለ ጽርዓት ወትረ ጊዜ ትሴብሕ ሥላሴ።","targetAnatomy":"ከ እንበለ","lang":"gez"},{"type":"paragraph","text":"ሱራፌልሃ ትመስል ወአኮ ብእሴ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ ነቅዓ ቅዳሴ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ሰላም ለከ በምህሮ ወንጌል ጊዮርጊስ ሐዋርያ።","targetAnatomy":"ከ በምህሮ","lang":"gez"},{"type":"paragraph","text":"ምስለ ኢየሱስ ወእሙ ማርያ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ዘነበርከ በቢታንያ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ሰላም ለከ ቀናዔ ኤልያስ ሐዲስ።","targetAnatomy":"ከ ቀናዔ","lang":"gez"},{"type":"paragraph","text":"ዘታነድዶሙ በእሳት ወባዕስ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ለአይሁድ ወለአርሲስ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"አርጋኖነ ድንግል ሰሚዓ ወውዳሴ መስቀል ብርሃን።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"በፍሥሐ ትብለከ ቤተ ክርስቲያን እንዚራ ከናፍርየ ወይን።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ጽጌ ሃይማኖት ትጽገይ በአፀደ ወይንከ ከርሣ፣","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"እንበለ ያማስንዋ በአበሳ፣","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ቆናጽለ ታስግር እም እንስሳ፣","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ንቃህ ጊዮርጊስ ወጣህር አንበሳ።","targetAnatomy":"ማኅሌት","lang":"gez"},{"type":"paragraph","text":"ሰላም ለከ እንዘ ትነውም ጊዮርጊስ ዘደብረ ባሕርይ ትሔ።","targetAnatomy":"ከ እንዘ","lang":"gez"},{"type":"heading","text":"ማኅተም (ጸሎት)","level":2,"lang":"gez"},{"type":"prayer","text":"መጽሐፈ ምስጢር ይሰብክ ጥበብከ ስባሔ።","lang":"gez"},{"type":"prayer","text":"ዘየዐውድ ውስተ ኲለሄ።","lang":"gez"},{"type":"prayer","text":"ዘአፍቀረከ በልቡ ለማርያም አፍቀራ፣","lang":"gez"},{"type":"prayer","text":"ወዘፀልአከ በአማን ፀራ፣","lang":"gez"},{"type":"prayer","text":"ጊዮርጊስ መሰንቆ ለቤተ ክርስቲያን ክብራ።","lang":"gez"},{"type":"prayer","text":"አፍቅረኒ አባ ወባርከኒ ባርኮ፣","lang":"gez"},{"type":"prayer","text":"እስመ ኲሉ ያፈቅር ለዘተአረኮ፣","lang":"gez"},{"type":"prayer","text":"ወያደሉ ለዘተልእኮ።","lang":"gez"}]}]}