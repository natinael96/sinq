{"id":"b0aef80d17","title":"መልክአ አባ ጊዮርጊስ ዘጋሥጫ","shelf":"melkie","chapters":[{"number":1,"title":"","blocks":[{"type":"heading","text":"መልክአ አባ ጊዮርጊስ ዘጋሥጫ","level":1,"lang":"gez"},{"type":"heading","text":"መቅድም","level":2,"lang":"gez"},{"type":"paragraph","text":"ይትፌሣሕ ልሳንየ በጽድቀ ዚአከ ዘልፈ።","lang":"gez"},{"type":"paragraph","text":"እንዘ አየድእ ዘስብሐቲከ ተረፈ።","lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ ዘኮንከ ለኅሊና ኲሉ መጽሐፈ።","lang":"gez"},{"type":"paragraph","text":"እስመ አኀዝኩ ሐረሳዌ በገራህተ ዚአከ ዕርፈ።","lang":"gez"},{"type":"paragraph","text":"ኀጠተ ውዳሴከ ዝራዕ ዘይፈሪ እልፈ።","lang":"gez"},{"type":"paragraph","text":"ሰላም ለዝክረ ስምከ ምሉአ ጸጋ ወሞገስ።","targetAnatomy":"ዝክረ ስምከ","index":1,"lang":"gez"},{"type":"paragraph","text":"ከመ ዝክረ ስሙ ዐባይ ለፀሐየ ልዳ ወፋርስ።","targetAnatomy":"ማኅሌት","index":2,"lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ ዕንቊ ዘወለደከ ተርሴስ።","targetAnatomy":"ማኅሌት","index":3,"lang":"gez"},{"type":"paragraph","text":"በጊዜ ንፍሐቱ ውስተ ገጸ ቀላይ ወየብስ።","targetAnatomy":"ማኅሌት","index":4,"lang":"gez"},{"type":"paragraph","text":"ለዘእምደቡብ ተንሥአ ነፋስ።","targetAnatomy":"ማኅሌት","index":5,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለሥዕርተ ርእስከ በቅብዐ ሃይማኖት ስቁይ።","targetAnatomy":"ሥዕርተ ርእስከ","index":6,"lang":"gez"},{"type":"paragraph","text":"ከመ እንተ ስኂን ምዑዝ ወከመ ቄድሮስ ኅሩይ።","targetAnatomy":"ማኅሌት","index":7,"lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ ትርሲት ወማኀቶተ ዓለም ባሕርይ።","targetAnatomy":"ማኅሌት","index":8,"lang":"gez"},{"type":"paragraph","text":"እምጸዳልከ ነጸብራቅ ወብርሃንከ ውኩይ።","targetAnatomy":"ማኅሌት","index":9,"lang":"gez"},{"type":"paragraph","text":"ኢይትፈቀድ ወርኅ ወምኑን ፀሐይ።","targetAnatomy":"ማኅሌት","index":10,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለርእስከ ዘተረሰየ አክሊለ።","targetAnatomy":"ርእስከ ዘተረሰየ","index":11,"lang":"gez"},{"type":"paragraph","text":"እምዕንቊ ክቡር እንተ ቦ ጸዳለ።","targetAnatomy":"ማኅሌት","index":12,"lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ ዘብከ በውስተ ኲሉ ክሂለ።","targetAnatomy":"ማኅሌት","index":13,"lang":"gez"},{"type":"paragraph","text":"አስተደሉ ለምእመናን ምሕረተ ወሣህለ።","targetAnatomy":"ማኅሌት","index":14,"lang":"gez"},{"type":"paragraph","text":"ወለዓላውያን ድምሳሴ ወኀጒለ።","targetAnatomy":"ማኅሌት","index":15,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለቀራንብቲከ እለ ሐተታ ለነጽሮ።","targetAnatomy":"ቀራንብቲከ እለ","index":16,"lang":"gez"},{"type":"paragraph","text":"ፍኖተ ኢየሱስ ክርስቶስ ወኲሎ ዐሠሮ።","targetAnatomy":"ማኅሌት","index":17,"lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ ጥዑም አርጋኖነ ስብሐት ወዘምሮ።","targetAnatomy":"ማኅሌት","index":18,"lang":"gez"},{"type":"paragraph","text":"ድምፅከ ድምፀ ጥበብ ወክላህከ አእምሮ።","targetAnatomy":"ማኅሌት","index":19,"lang":"gez"},{"type":"paragraph","text":"እስከ ይእዜ በውስተ ኲሉ ይደምፅ ለምህሮ።","targetAnatomy":"ማኅሌት","index":20,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለአዕይንቲከ ዘዘልፈ ይጸድላ።","targetAnatomy":"አዕይንቲከ ዘዘልፈ","index":21,"lang":"gez"},{"type":"paragraph","text":"እምነ ቶማስሰ ወእብላ።","targetAnatomy":"ማኅሌት","index":22,"lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ ጽጌ ወመድምመ ስን ሄላ።","targetAnatomy":"ማኅሌት","index":23,"lang":"gez"},{"type":"paragraph","text":"እንተ አሰርገውከ ለገነተ ወንጌል ማእከላ።","targetAnatomy":"ማኅሌት","index":24,"lang":"gez"},{"type":"paragraph","text":"ወመዐዛከ ነፈርአጽ ወጼናከ ተድላ።","targetAnatomy":"ማኅሌት","index":25,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለአእዛኒከ እለ ዘልፈ ኮና።","targetAnatomy":"አእዛኒከ እለ","index":26,"lang":"gez"},{"type":"paragraph","text":"ለቤተክርስቲያን ህየንተ እዝና።","targetAnatomy":"ማኅሌት","index":27,"lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ ሰሎሞን በዕፀ ቄድሮስ ወዕፀ ጳውቄና።","targetAnatomy":"ማኅሌት","index":28,"lang":"gez"},{"type":"paragraph","text":"እም አመ አቅዘዝከ ውስተ ሰማያዊት ጸቆና።","targetAnatomy":"ማኅሌት","index":29,"lang":"gez"},{"type":"paragraph","text":"ብዙኃን ሰረቅት ኢረከቡ ፍና።","targetAnatomy":"ማኅሌት","index":30,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለመላትሒከ አፈዋተ ዘፈረያ።","targetAnatomy":"መላትሒከ አፈዋተ","index":31,"lang":"gez"},{"type":"paragraph","text":"እለ ይሜስላ አምሳለ ዘዕፀ ገነት አርአያ።","targetAnatomy":"ማኅሌት","index":32,"lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ መምህር ወሠላጤ መልእክት ሐዋርያ።","targetAnatomy":"ማኅሌት","index":33,"lang":"gez"},{"type":"paragraph","text":"ወአንተኬ ለባሕረ ሃይማኖት ጌልያ።","targetAnatomy":"ማኅሌት","index":34,"lang":"gez"},{"type":"paragraph","text":"ወአንተኬ ማእምር ኖትያ።","targetAnatomy":"ማኅሌት","index":35,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለገጽከ ውስተ ገጸ ክርስቶስ ዘአንጸረ።","targetAnatomy":"ገጽከ ውስተ","index":36,"lang":"gez"},{"type":"paragraph","text":"እንዘ ኢይትመየጥ ድኅረ።","targetAnatomy":"ማኅሌት","index":37,"lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ ዘኮንከ ለቤተ ክርስቲያን ሐመረ።","targetAnatomy":"ማኅሌት","index":38,"lang":"gez"},{"type":"paragraph","text":"በነፊሖቶሙ ሶበ ጐድኡ ባሕረ።","targetAnatomy":"ማኅሌት","index":39,"lang":"gez"},{"type":"paragraph","text":"አቦርዮስ ወአውጣኪ ዘዐረዩ ምክረ።","targetAnatomy":"ማኅሌት","index":40,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለከናፍሪከ ዘመለኮተ ይትናገራ።","targetAnatomy":"ከናፍሪከ ዘመለኮተ","index":41,"lang":"gez"},{"type":"paragraph","text":"ዘኢይትረሳእ ለዝላፍ ወኢይትኃደግ ለግሙራ።","targetAnatomy":"ማኅሌት","index":42,"lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ መምህር ወነቢይ ከመ ዕዝራ።","targetAnatomy":"ማኅሌት","index":43,"lang":"gez"},{"type":"paragraph","text":"ሶበ ትዘብጥ በዜማ አርጋኖነ ስብሐት መዝሙራ።","targetAnatomy":"ማኅሌት","index":44,"lang":"gez"},{"type":"paragraph","text":"ማርያም ትትፌሣሕ ወይትኃሠይ በኩራ።","targetAnatomy":"ማኅሌት","index":45,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለአፉከ ዘተሰውጠ ቦቱ።","targetAnatomy":"አፉከ ዘተሰውጠ","index":46,"lang":"gez"},{"type":"paragraph","text":"ለሙሴ ትንቢቱ ወለጳውሎስ ዕፍረቱ።","targetAnatomy":"ማኅሌት","index":47,"lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ ብርሃን በመልዕልተ ተቅዋም ዘተኀቱ።","targetAnatomy":"ማኅሌት","index":48,"lang":"gez"},{"type":"paragraph","text":"ሶበ ኪያከ ይጼዕሉ ወመጽሐፈከ ያሰትቱ።","targetAnatomy":"ማኅሌት","index":49,"lang":"gez"},{"type":"paragraph","text":"ነአምሮሙ ለአይሁድ በዝንቱ።","targetAnatomy":"ማኅሌት","index":50,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለአስናኒከ ከመ መራዕይ እለ ተቀርፃ።","targetAnatomy":"አስናኒከ ከመ","index":51,"lang":"gez"},{"type":"paragraph","text":"ወእለ እምሕጻብ ሐወፃ።","targetAnatomy":"ማኅሌት","index":52,"lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ መሰንቆ ለዝክርከ ቃለ ተግሣፃ።","targetAnatomy":"ማኅሌት","index":53,"lang":"gez"},{"type":"paragraph","text":"ጊዜ አንሶሰዉ በውስተ ኲሉ ወበጊዜ ተሰምዓ ድምፃ።","targetAnatomy":"ማኅሌት","index":54,"lang":"gez"},{"type":"paragraph","text":"ነገሥታተ ምድር ይሁብዋ ሞፃ።","targetAnatomy":"ማኅሌት","index":55,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለአዕናፊከ እለ ይነፍሓ ለጥዒና።","targetAnatomy":"አዕናፊከ እለ","index":56,"lang":"gez"},{"type":"paragraph","text":"ነፋሰ መዐዛ ወጼና።","targetAnatomy":"ማኅሌት","index":57,"lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ ዕንቊ ጥሪተ ማርያም ወሕፃና።","targetAnatomy":"ማኅሌት","index":58,"lang":"gez"},{"type":"paragraph","text":"ዝክርከ ኃሤተ ልብ ወጣዕመ ፍቅርከ መና።","targetAnatomy":"ማኅሌት","index":59,"lang":"gez"},{"type":"paragraph","text":"ከመ ሞገደ ባሕር ጽኑዕ የሐውክ ኅሊና።","targetAnatomy":"ማኅሌት","index":60,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለጉርዔከ ለመቅደሰ ስብሐት አንቀጹ።","targetAnatomy":"ጉርዔከ ለመቅደሰ","index":61,"lang":"gez"},{"type":"paragraph","text":"መደንግፀ ክላሑ ወድምፀ ነጐድጓድ ድምፁ።","targetAnatomy":"ማኅሌት","index":62,"lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ ምዑዝ ለልሳነ ዕፍረት ቢጹ።","targetAnatomy":"ማኅሌት","index":63,"lang":"gez"},{"type":"paragraph","text":"ነገሥታተ (በእንቲአከ) ምድር እለ በመዐዛከ ሮፁ።","targetAnatomy":"ማኅሌት","index":64,"lang":"gez"},{"type":"paragraph","text":"በአእባነ ብሩር ወወርቅ ቤተከ ሐነፁ።","targetAnatomy":"ማኅሌት","index":65,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለክሳድከ ሐብለ ሥላሴ አኒቆ።","targetAnatomy":"ክሳድከ ሐብለ","index":66,"lang":"gez"},{"type":"paragraph","text":"ይትቀሠፍ ድኅረ ሃይማኖተ ለአጠይቆ።","targetAnatomy":"ማኅሌት","index":67,"lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ ፍትው ለቤተክርስቲያን መሰንቆ።","targetAnatomy":"ማኅሌት","index":68,"lang":"gez"},{"type":"paragraph","text":"ለድምፀ በዐልከ እንዘ ይጸንሖ ተዐውቆ።","targetAnatomy":"ማኅሌት","index":69,"lang":"gez"},{"type":"paragraph","text":"እም ዮሐንስ ባቲ ዘዘልፈ ናፍቆ።","targetAnatomy":"ማኅሌት","index":70,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለመትከፍትከ እለ አንሐ ተወክፎ።","targetAnatomy":"መትከፍትከ እለ","index":71,"lang":"gez"},{"type":"paragraph","text":"አርዑተ ኢየሱስ ቀሊለ ለዓለም ዘየዐርፎ።","targetAnatomy":"ማኅሌት","index":72,"lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ ክሥት ለጥበብከ መጽሐፎ።","targetAnatomy":"ማኅሌት","index":73,"lang":"gez"},{"type":"paragraph","text":"ከመ ትሰብሓ ለማርያም ወከመ ለቢቱ ትዝልፎ።","targetAnatomy":"ማኅሌት","index":74,"lang":"gez"},{"type":"paragraph","text":"እስመ ዓይነ ኵሉ ዘሥጋ ኪያከ ይሴፎ።","targetAnatomy":"ማኅሌት","index":75,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለልሳንከ ልሳነ ጥበብ ወልባዌ።","targetAnatomy":"ልሳንከ ልሳነ","index":76,"lang":"gez"},{"type":"paragraph","text":"ማእከለ ከናፍር ወአፍ እንተ ረሰየ ህላዌ።","targetAnatomy":"ማኅሌት","index":77,"lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ መድኅን መትልወ ኢያሱ ዘነዌ።","targetAnatomy":"ማኅሌት","index":78,"lang":"gez"},{"type":"paragraph","text":"እስከ እትቤቀሎ ለፀርየ ወለእደወ ደምየ አርዌ።","targetAnatomy":"ማኅሌት","index":79,"lang":"gez"},{"type":"paragraph","text":"ዐቅም ሊተ ፀሐየ ሥጋዌ።","targetAnatomy":"ማኅሌት","index":80,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለቃልከ ከመ ቀለመ ጸሓፊ ዘሐፈጣ።","targetAnatomy":"ቃልከ ከመ","index":81,"lang":"gez"},{"type":"paragraph","text":"ኆኅያተ ወንጌል ሐዳስ ወነገረ ብሉይ የውጣ።","targetAnatomy":"ማኅሌት","index":82,"lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ ጴጥሮስ ወኤልሳዕ ዘትዝቤጣ።","targetAnatomy":"ማኅሌት","index":83,"lang":"gez"},{"type":"paragraph","text":"ለቃልከ ዕፍረተ ተድላ ዘእደ ኢየሱስ ፀዐጣ።","targetAnatomy":"ማኅሌት","index":84,"lang":"gez"},{"type":"paragraph","text":"ክበደ ሰማያት ወምድር ኢይከውን ሤጣ።","targetAnatomy":"ማኅሌት","index":85,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለእስትንፋስከ ዘይነፍሕ ርጢነ።","targetAnatomy":"እስትንፋስከ ዘይነፍሕ","index":86,"lang":"gez"},{"type":"paragraph","text":"እመንፈስ ቅዱስ ነሢኦ ሥልጣነ።","targetAnatomy":"ማኅሌት","index":87,"lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ ቀርን እንተ ትሰብክ ግዕዛነ።","targetAnatomy":"ማኅሌት","index":88,"lang":"gez"},{"type":"paragraph","text":"ቃለ ትግሣጽከ ያጠብብ አብዳነ።","targetAnatomy":"ማኅሌት","index":89,"lang":"gez"},{"type":"paragraph","text":"ወሕገ አፉከ ይሴብሕ ጻድቃነ::","targetAnatomy":"ማኅሌት","index":90,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለአዕዳዊከ እለ ያጸንዓ መርኆ።","targetAnatomy":"አዕዳዊከ እለ","index":91,"lang":"gez"},{"type":"paragraph","text":"አንቀጽ ማኅሌት ወሰብሖ።","targetAnatomy":"ማኅሌት","index":92,"lang":"gez"},{"type":"paragraph","text":"ጊዮርጊስ ጻሙ ዐሰበ ከናፍርየ ለአጽንሖ።","target