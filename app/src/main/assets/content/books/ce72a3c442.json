{"id":"ce72a3c442","title":"መልክአ ኪዳነ ምሕረት","shelf":"melkie","chapters":[{"number":1,"title":"መልክአ ኪዳነ ምሕረት","blocks":[{"type":"heading","text":"መልክአ ኪዳነ ምሕረት","level":1,"lang":"gez"},{"type":"paragraph","text":"እግዝአብሔር አብ","lang":"gez"},{"type":"paragraph","text":"እግዝአብሔር አብ ወኅቤ ብርሃን ዘይሤለስ በአካሉ።","lang":"gez"},{"type":"paragraph","text":"እንዘ ተዋህዶ ያጸንዕ በመለኮቱ ወኃይሉ።","lang":"gez"},{"type":"paragraph","text":"ዐይነ ልቡናየ ያብርህ በማኅቶተ ጥበብ ሥነ ጸዳሉ።","lang":"gez"},{"type":"paragraph","text":"ከመ ይርአይ ገጸ ነገር ለኪዳንኪ ዘይደሉ።","lang":"gez"},{"type":"paragraph","text":"ማርያም እግዝእተ ኲሉ ዘታሕቱ ወላዕሉ።","lang":"gez"},{"type":"paragraph","text":"ሰላም ለዝክረ ስምኪ ዘአስተማሰልዎ በኮከብ።","lang":"gez"},{"type":"paragraph","text":"ሶበ ብርሃኖ ተከድኑ ጽልሙታነ ራእይ ሕዝብ።","lang":"gez"},{"type":"paragraph","text":"ኪዳነ አምላክ ማርያም ወተስፋ መድኃኒት ዘዐርብ።","lang":"gez"},{"type":"paragraph","text":"ተናዘዘ ብኪ አኮኑ ኅሊና ቀዳማይ አብ።","lang":"gez"},{"type":"paragraph","text":"አመ እምገነቱ ተሰደ በኅዘን ዕፁብ።","lang":"gez"},{"type":"paragraph","text":"ሰላም ለስእርተ ርእስኪ ዘፈትለ ሜላት ዘውጋ ።","lang":"gez"},{"type":"paragraph","text":"ወምልዕት ይእቲ እምጠለ ሰማይ እንበለ ንትጋ።","lang":"gez"},{"type":"paragraph","text":"ለዘተካየደኪ ማርያም ኪዳነ ምሕረት ቅድመ","lang":"gez"},{"type":"paragraph","text":"እንግልጋ።","lang":"gez"},{"type":"paragraph","text":"ሰአሊዮ ሕይወተ ነፍስየ ይጸግወኒ በጸጋ።","lang":"gez"},{"type":"paragraph","text":"አምሳለ ኤልያስ አኮ ያሕይወኒ በሥጋ።","lang":"gez"},{"type":"paragraph","text":"ሰላም ለርእስኪ ዘሀሎ ወይሄሉ።","lang":"gez"},{"type":"paragraph","text":"ዲበ ጠባይዓት ኲሉ።","lang":"gez"},{"type":"paragraph","text":"ተካየድኒ ማርያም በኪዳንኪ ዘይደሉ።","lang":"gez"},{"type":"paragraph","text":"ምስለ ሞትሰ ተካየድነ ወተመሐልነ ዘይብሉ።","lang":"gez"},{"type":"paragraph","text":"ከንቶ ነበቡ ወነፍሶሙ ኅጒሉ።","lang":"gez"},{"type":"paragraph","text":"ሰላም ለገጽኪ ገጸ ቅድስና ስቡሕ።","lang":"gez"},{"type":"paragraph","text":"ዘይኤድም ሥኑ እምጸዳለ ፀሐይ ወወርኅ።","lang":"gez"},{"type":"paragraph","text":"ትእምርተ ኪዳን ማርያም ወቀስተ ደመና ብሩህ።","lang":"gez"},{"type":"paragraph","text":"እምኀበ አምላክ መሐሪ እምአመ ነሥአኪ ኖኅ።","lang":"gez"},{"type":"paragraph","text":"አማስኖታ ለምድር ኢደገመ አይኅ።","lang":"gez"},{"type":"paragraph","text":"ሰላም ለ ቀራብትኪ ንጻሬ አዕይንት ለዑቃቤ።","lang":"gez"},{"type":"paragraph","text":"እለ ሥዩማት እማንቱ ህየንተ ምስዋር ወግልባቤ።","lang":"gez"},{"type":"paragraph","text":"ማርያም በሊዮ ለዘወለድኪዮ በኢሩካቤ።","lang":"gez"},{"type":"paragraph","text":"አይቴ ቃልከ እግዚኦ እምሕር ለኪ ዘይቤ።","lang":"gez"},{"type":"paragraph","text":"ለእመኃጥኣን ጸውዑ ስመኪ ነባቤ።","lang":"gez"},{"type":"paragraph","text":"ሰላም ለአዕይንትኪ አምሳለ ክልኤቲ ቀናዲል።","lang":"gez"},{"type":"paragraph","text":"እንተ ሰቀሎን ኬኒያ በማኅፈደ ሥጋ ልዑል።","lang":"gez"},{"type":"paragraph","text":"ማርያም አንቲ ነቅዐ ተራኅርኆ ወሣህል።","lang":"gez"},{"type":"paragraph","text":"አድኅንኒ በኪዳንኪ ወባልሕኒ እምኅጒል።","lang":"gez"},{"type":"paragraph","text":"እስመ ዘእንበሌኪ አልቦ አድኅኖ ዘይክል።","lang":"gez"},{"type":"paragraph","text":"ሰላም ለአዕዛንኪ እለ ተበሥራ ኪዳነ።","lang":"gez"},{"type":"paragraph","text":"እምአፈ ፈጣሪ ወልድኪ ዘባሕርየኪ ተከድነ።","lang":"gez"},{"type":"paragraph","text":"አምሕለኪ ማርያም ከመ ኢታርእይኒ ደይነ።","lang":"gez"},{"type":"paragraph","text":"እንበለ ምግባር ባሕቱ እመ ኢይጸድቅ አነ።","lang":"gez"},{"type":"paragraph","text":"ቦኑ ለከንቱ ኪዳንኪ ኮነ።","lang":"gez"},{"type":"paragraph","text":"ሰላም ለመላትሕኪ ጽጌያተ ሮማን እለ ይመስላ።","lang":"gez"},{"type":"paragraph","text":"ባሕቱ መጽለዋ ለእሳተ አንብዕ በነበልባላ።","lang":"gez"},{"type":"paragraph","text":"በኪዳንኪ ማርያም አዕርግኒ ዐፀደ ተድላ።","lang":"gez"},{"type":"paragraph","text":"ወይ ለነዓሌ ለነ አመ ውስተ ደይን ይብላ።","lang":"gez"},{"type":"paragraph","text":"ነፍሳተ ክልኤቲ አኃት ሐሊባ ወሐላ።","lang":"gez"},{"type":"paragraph","text":"ሰላም ለ አዕናፍኪ","lang":"gez"},{"type":"paragraph","text":"ሰላም ለ አዕናፍኪ መሳክወ ሕይወት ምንታዌ።","lang":"gez"},{"type":"paragraph","text":"ዘአስተዋደዶን አምላክ በአጽባዕተ ጥበብ ወልባዌ።","lang":"gez"},{"type":"paragraph","text":"ማርያም ሕጽርኒ በኃይለ ኪዳንኪ እምንሳዌ።","lang":"gez"},{"type":"paragraph","text":"ወቀጥቅጢ ርእሶ በአብትረ ሕማም ወደዌ።","lang":"gez"},{"type":"paragraph","text":"ለእመ አፉሁ አብቀወ የሐጠኒ አርዌ።","lang":"amh"},{"type":"paragraph","text":"ሰላም ለከናፍርኪ በእንተ ኃጥኣን እለ ሰአላ።","lang":"gez"},{"type":"paragraph","text":"እምኀበ አምላክ መሐሪ ኪዳነ ምሕረት ወመሐላ።","lang":"gez"},{"type":"paragraph","text":"እስከ ጎልጎታ ማርያም አመ ገይሦትኪ እምገሊላ።","lang":"gez"},{"type":"paragraph","text":"ለጽድቀ ዛቲ ኪዳንኪ ለለይከውን በዓላ።","lang":"gez"},{"type":"paragraph","text":"ዲበ ርእሰ ኃጥእ ገብርኪ አንብሪ አክሊላ።","lang":"gez"},{"type":"paragraph","text":"ሰላም ለአፉኪ አፈ በረከት ትሩፍ።","lang":"gez"},{"type":"paragraph","text":"ወአንቀጸ ቅዱስ መጽሐፍ።","lang":"gez"},{"type":"paragraph","text":"ተማኅፀንኩ ማርያም በኪዳንኪ ውኩፍ።","lang":"gez"},{"type":"paragraph","text":"ኢይትኅፈር ቅድመ ወልድኪ ወመላእክቲሁ አዕላፍ።","lang":"gez"},{"type":"paragraph","text":"አመ ሥርወ ልሳን ይትመተር ወይትኅተም አፍ።","lang":"gez"},{"type":"paragraph","text":"ሰላም ለአስናንኪ ከመ መራዕይ እለ ተቀርፃ።ወለ","lang":"gez"},{"type":"paragraph","text":"ወፅኣ እምሕፃብ እንዘ ይትባየጻ።","lang":"gez"},{"type":"paragraph","text":"ማርያም ንሥእኒ ዐሥራተ ኪዳን ህየንተ ሞፃ","lang":"gez"},{"type":"paragraph","text":"ወለእድውየ ግብፃዊ ዘፍትወተ ልቡ ዓመፃ።","lang":"gez"},{"type":"paragraph","text":"መዝራዕተ ጸሎትኪ ሙሴ ይድፍኖ በኆፃ።","lang":"gez"},{"type":"paragraph","text":"ሰላም ለልሳንኪ ዘአፈድፈደ ቅዳሴ።","lang":"gez"},{"type":"paragraph","text":"እምካህናተ ሰማይ ሱራፌል እለ ይቀውሙ ቅድመ ሥላሴ","lang":"gez"},{"type":"paragraph","text":"አዘክሪ ሊተ ማርያም ተዝካረ ኪዳንኪ አመ ድምሳሴ።","lang":"gez"},{"type":"paragraph","text":"በእንተ እስራኤል በገዳም ከመ አዘከረ አውሴ።","lang":"gez"},{"type":"paragraph","text":"ኪዳነ ሠለስቱ አበው ወጽድቆ ለሙሴ።","lang":"gez"},{"type":"paragraph","text":"ሰላም ለቃልኪ ተሰጣዌ ቃል እምቃሉ።","lang":"gez"},{"type":"paragraph","text":"ለመልአከ ብሥራት ገብርኤል ዘጸዳለ ብርሃን ሠርጎ መንዲሉ።","lang":"gez"},{"type":"paragraph","text":"ማርያም ቅድስት ለእግዝአብሔር መካነ ኃይሉ።","lang":"gez"},{"type":"paragraph","text":"እንቋዕ እንቋዕ ወሀበኪ ኪዳነ ምሕረት ወሣህሉ።","lang":"gez"},{"type":"paragraph","text":"በዘቦቱ ጸዲቀ ኃጥኣን ይክሉ።","lang":"gez"},{"type":"paragraph","text":"ሰላም ለእስትንፋስኪ ነፋሰ ጥዒና ፈዋሲ።","lang":"gez"},{"type":"paragraph","text":"ነፍሳተ ኃጥኣን ሰብእ እለ ቌስሉ በኅምዘ ከይሲ።","lang":"gez"},{"type":"paragraph","text":"በኪዳንኪ ማርያም ኃጣውእየ ደምስሲ።","lang":"gez"},{"type":"paragraph","text":"እንበለ ኪዳንኪሰ ወመስቀለ ክርስቶስ ወራሲ።","lang":"gez"},{"type":"paragraph","text":"አልቦ እምሲኦል ዘይድኅን ብእሲ።","lang":"gez"},{"type":"paragraph","text":"ሰላም ለጒርዔኪ ሠናይ ወአዳም።","lang":"gez"},{"type":"paragraph","text":"እንተ ይትፈለጡ ቦቱ ጸዋትወ ምረር ወጣዕም።","lang":"gez"},{"type":"paragraph","text":"ምንተ እግበር ለኪ ማርያም እስመ ኃይልየ ድኩም።","lang":"gez"},{"type":"paragraph","text":"ዓፀበኒ ግብር እምኲለሄ ወፀበበኒ ዓለም።","lang":"gez"},{"type":"paragraph","text":"ባሕቱ በኪዳንኪ ናዝዝኒ እም።","lang":"gez"},{"type":"paragraph","text":"ሰላም ለክሳድኪ ዘማኅፈደ ዳዊት ተርእዮታ።ዲበ","lang":"gez"},{"type":"paragraph","text":"ተልፍዮስ ጠቢባን ዘአስተናደፉ መሠረታ ማርያም","lang":"gez"},{"type":"paragraph","text":"በሊ ውስተ ዕዝነ ነፍስየ ለናዝዞታ።","lang":"gez"},{"type":"paragraph","text":"ለምንት ብዙኃ ትሠርሒ ነፍስየ ገብርየ ማርታ","lang":"gez"},{"type":"paragraph","text":"እስመ ኅዳጥ የአክል እምብዙኅ ሐተታ።","lang":"gez"},{"type":"paragraph","text":"ሰላም ለመታክፍትኪ ግዕዛነ በረከት እለ ተወክፋ።","lang":"gez"},{"type":"paragraph","text":"እምቅኔ መርገም ወዘለፋ።","lang":"gez"},{"type":"paragraph","text":"ማርያም ጹርኒ ለጽድቀ ኪዳንኪ ዲበ መትከፋ።","lang":"gez"},{"type":"paragraph","text":"ወንሥእኒ ዐሥራተ እድ እመርዔተ ወልድኪ አልፋ።","lang":"gez"},{"type":"paragraph","text":"እስመ ሃይማኖትየ አንቲ ወዘብየ ተስፋ።","lang":"gez"},{"type":"paragraph","text":"ሰላም ለዘባንኪ በወርኃ ተሰዶ ቀዲሙ።","lang":"gez"},{"type":"paragraph","text":"ምዕራፈ አምላክ ዘኮነ ውስተ ፍኖተ ቊስቋም ጊዜ ድካሙ።","lang":"gez"},{"type":"paragraph","text":"ማርያም ስመኪ ለዘፆረ መልዕልተ ስሙ።","lang":"gez"},{"type":"paragraph","text":"በእለተ ኲነኔ ደኃሪት እመ ኢያስለጠ ደሙ።","lang":"gez"},{"type":"paragraph","text":"ዐሥራተ ምሕረት ንሥኢዮ መሐሪት እሙ።","lang":"gez"},{"type":"paragraph","text":"ሰላም ለእንግድዓኪ ወለሕፅንኪ ካልእታ።","lang":"gez"},{"type":"paragraph","text":"ወለአዕዳውኪ መንታ።","lang":"gez"},{"type":"paragraph","text":"አምሕለኪ ማርያም በነጸፍጻፈ ደም ዘጎልጎታ","lang":"gez"},{"type":"paragraph","text":"ለነፍስየ ምስለ ነፍስኪ አስተዳልዊ መክፈልታ።","lang":"gez"},{"type":"paragraph","text":"አመ መሬታዊት ሥጋየ ትትከደን መሬታ።","lang":"gez"},{"type":"paragraph","text":"ሰላም ለመዛርዕኪ ወለኲርናዕኪ ምፅንጋዕ።","lang":"gez"},{"type":"paragraph","text":"እለ ሐቀፋሁ ለክርስቶስ ባርሕየ መለኮት ኅቡዕ።","lang":"gez"},{"type":"paragraph","text":"ማርያም ኅሪት እምነ መላእክት ወሰብእ።","lang":"gez"},{"type":"paragraph","text":"ተዝካረኪ ለእመ ገብረ በተአምኖ ጽኑዕ።","lang":"gez"},{"type":"paragraph","text":"በመንግሥተ ሰማይ ምስሌኪ ይነግሥ ኃጥእ።","lang":"gez"},{"type":"paragraph","text":"ሰላም ለእመታትኪ በመቅደሰ አምላክ ቀዋሚ።","lang":"gez"},{"type":"paragraph","text":"እለ አሠነያ ወርቀ ምስለ ፈትለ ሜላት ግብረ አናሚ።","lang":"gez"},{"type":"paragraph","text":"ማርያም ላዕሌየ ኪዳነ ምሕረት ፈጽሚ","lang":"gez"},{"type":"paragraph","text":"ወትትሊ ፀረ ነፍስየ እስመ ውእቱ ረጋሚ።","lang":"gez"},{"type":"paragraph","text":"ከመ በጥበቡ ሰሎሞን ቀተሎ ለሳሚ።","lang":"gez"},{"type":"paragraph","text":"ሰላም ለእራኅኪ ተመጣዌ ኅብስት ወማይ።","lang":"gez"},{"type":"paragraph","text":"ሶበ ያመጽኡ ለኪ መላእክተ ሰማይ።","lang":"gez"},{"type":"paragraph","text":"እንዘ ሀሎኪ ማርያም በመቅደሰ ኦሪት ዐባይ።","lang":"gez"},{"type":"paragraph","text":"ይትወከፍ ሊተ ኪዳንኪ ከመ መሥዋዕተ ሠርክ ኅሩይ።","lang":"gez"},{"type":"paragraph","text":"ለእመ ኅፍነማይ አስተይኩ ለጽሙዕ ነዳይ።","lang":"gez"},{"type":"paragraph","text":"ሰላም ለአጻብዕኪ ወለአጽፋርኪ ጸዐድው።","lang":"gez"},{"type":"paragraph","text":"ወለአጥባትኪ ክልኤ አንቅዕተ ሐሊብ ቅድው።","lang":"gez"},{"type":"paragraph","text":"ማርያም ጽጌ ዘዘመንኪ መፀው።","lang":"gez"},{"type":"paragraph","text":"ተማኅፀንኩ በአጥባትኪ ወበስንኪ ፍትው።","lang":"gez"},{"type":"paragraph","text":"በኃይለ ኪዳንኪ እድኅን እምእሳት ድልው።","lang":"gez"},{"type":"paragraph","text":"ሰላም ለገበዋትኪ እመንገለ ለፌ ወለፌ።","lang":"gez"},{"type":"paragraph","text":"እለ ተረሰያ ደርገ ሐመልማለ ወርቅ ኢኃላፌ።","lang":"gez"},{"type":"paragraph","text":"ማርያም ምጥቅኒ በገቦ ኪዳንኪ ምስለ ሑቃፌ","lang":"gez"},{"type":"paragraph","text":"አመ ይወርዱ ኃጥኣን በብሔረ ጽልመት ጸናፌ።","lang":"gez"},{"type":"paragraph","text":"እስመ በሕይወቶሙ ጸልዑ ዘጻድቃን ሱታፌ።","lang":"gez"},{"type":"paragraph","text":"ሰላም ለከርሥኪ ዘከርሠ መላእክት ዘውጉ።","lang":"gez"},{"type":"paragraph","text":"ወኅብስተ ሰማይ ወትረ ዘይሴሰይ ዐቅመ ምዕራጉ።","lang":"gez"},{"type":"paragraph","text":"ማርያም ጽዮን ለእግዝአብሔር ታቦተ ሕጉ።","lang":"gez"},{"type":"paragraph","text":"ያንጽሐኒ እምፍቅረ ወርቅ ለማየ ኪዳንኪ አይጉ","lang":"gez"},{"type":"paragraph","text":"እስመ ፍቅረ ንዋይ ተብህለ ለሰይጣን ኤረጉ።","lang":"gez"},{"type":"paragraph","text":"ሰላም ለልብኪ ስንዕወ ኲልያት ወኅሊና።","lang":"gez"},{"type":"paragraph","text":"ለአማዑትኪ ሰላም፤ ወለንዋየ ውስጥኪ በዕሪና","lang":"gez"},{"type":"paragraph","text":"ውስተ ምድረ ርስት አብእኒ ማርያም ቀስተ ደመና።","lang":"gez"},{"type":"paragraph","text":"በብርሃነ እሳት ኪዳንኪ እንዘ ትመርህኒ ፍና","lang":"gez"},{"type":"paragraph","text":"ወትሴስይኒ እምፍቅርኪ መና።","lang":"gez"},{"type":"paragraph","text":"ሰላም ለኅንብርትኪ ምሳሌ ፍሑቅ ማዕከክ።","lang":"gez"},{"type":"paragraph","text":"ወለማኅፀንኪ ንጹሕ ምስለ ሐቌኪ ቡሩክ።","lang":"gez"},{"type":"paragraph","text":"ማርያም ቅድስት ወላዲተ ክርስቶስ አምላክ።","lang":"gez"},{"type":"paragraph","text":"ተዐየኒ ዐውደ ነፍስየ እስከ ሣልሳዊ ፈለክ።","lang":"gez"},{"type":"paragraph","text":"አመ ተቃውማ በአየር ቀናዒ መልአክ።","lang":"gez"},{"type":"paragraph","text":"ሰላም ለድንግልናኪ መክብበ ሕዋሳት ኅምስ።","lang":"gez"},{"type":"paragraph","text":"ወለአቊያጽኪ ክልኤ አዕማደ ነባቢት መቅደስ።","lang":"gez"},{"type":"paragraph","text":"ማርያም ታቦት ወጽላተ ኪዳን ሐዲስ።","lang":"gez"},{"type":"paragraph","text":"ቅብዕኒ ርጢነ ደም እስከ ሰኮና እግር ወርእስ","lang":"gez"},{"type":"paragraph","text":"እስመ ጾም ትፌውስ ሕማማ ለነፍስ።","lang":"gez"},{"type":"paragraph","text":"ሰላም ለአብራክኪ ጊዜ አስተብርኮ ወተንብሎ።","lang":"gez"},{"type":"paragraph","text":"ምስለ አእጋርኪ ደርገ እለ ይሰግዳ በኢያብጥሎ።","lang":"amh"},{"type":"paragraph","text":"ማርያም ለአብ እንተ ተሳተፍኪ ቃሎ።","lang":"gez"},{"type":"paragraph","text":"ሰአሊዮ ሕይወተ ነፍስ ይጸግወኒ ሣህሎ።","lang":"gez"},{"type":"paragraph","text":"አመ ውስተ እሳት ይወዲ ኃጥኣነ ኲሎ።","lang":"gez"},{"type":"paragraph","text":"ሰላም ለሰኮናኪ ወለመከየድኪ እለ ሖራ።","lang":"gez"},{"type":"paragraph","text":"እስከ ደብረ ቊስቋም ለደቂቅ አመ ቀተልዎ ሐራ።","lang":"gez"},{"type":"paragraph","text":"ለአምላከ ሰማይ በሊዮ ማርያም ወለተ ቅስራ።","lang":"gez"},{"type":"paragraph","text":"አማንኑ ትኴንና በእንተ ሠላስ ነገራ።","lang":"gez"},{"type":"paragraph","text":"ለዘታፈቅረከ ነፍስ በኲሉ ምግባራ።","lang":"gez"},{"type":"paragraph","text":"ሰላም ለአጻብዕኪ አቅርንተ አዕጋር ክልኤቲ።","lang":"amh"},{"type":"paragraph","text":"ወለአጽፋሪሆን ለለአሐቲ ።","lang":"gez"},{"type":"paragraph","text":"በኪዳንኪ ማርያም ኃጢአትየ ክብቲ።","lang":"gez"},{"type":"paragraph","text":"ሰብእሰ እንዘ ከማየ መዋቲ።","lang":"gez"},{"type":"paragraph","text":"በጽዋዐ ልሳን ደምየ ቀዲሖ ይሰቲ።","lang":"gez"},{"type":"paragraph","text":"ሰላም ለቆምኪ አየረ ትሩፋት ዘሐፀኖ።","lang":"gez"},{"type":"paragraph","text":"ወዐውሎ ኃጢአት ዘኢያጽነኖ ።","lang":"gez"},{"type":"paragraph","text":"ማርያም ክድንኒ በክንፈ ኪዳንኪ እምተኮንኖ።","lang":"gez"},{"type":"paragraph","text":"ሶበሰ ኪዳንኪ ምክንያተ ድኂን ኢኮኖ።","lang":"gez"},{"type":"paragraph","text":"ነፍሰ በላዔ ሰብእ በምንት እምክህለ አድኅኖ።","lang":"gez"},{"type":"paragraph","text":"ሰላም ለመልክእኪ እመልክአ ሐና ወኤልሳቤጥ","lang":"gez"},{"type":"paragraph","text":"ዘብዑድ ሥኑ ወልምላሜሁ ፍሉጥ።","lang":"gez"},{"type":"paragraph","text":"ማርያም ቅድስት ድንግልተ አፍኣ ወውስጥ።","lang":"gez"},{"type":"paragraph","text":"ቤዛ ይኩነኒ ኪዳንኪ በገጸ ፈጣሪ ሥሉጥ።","lang":"gez"},{"type":"paragraph","text":"አመ ወርኅ ነጊድ የኃልቅ ወይጸራዕ ሤጥ።","lang":"gez"},{"type":"paragraph","text":"ሰላም ለፀዓተ ነፍስኪ በነጽሮ ብርሃን ዘየሐቱ።","lang":"gez"},{"type":"paragraph","text":"መልአከ አፍርሆ ጸሊም እንበለ ያደንግጽኪ በጽላሎቱ።","lang":"gez"},{"type":"paragraph","text":"አምሕለኪ ማርያም ለእግዝአብሔር በመለኮቱ።","lang":"gez"},{"type":"paragraph","text":"ከመ ታድኅንኒ በኪዳንኪ እመደንግፃን ሠለስቱ","lang":"gez"},{"type":"paragraph","text":"አመ ይፈልጠኒ ሞት እምሥጋየ ዝንቱ።","lang":"gez"},{"type":"paragraph","text":"ሰላም ለበድነ ሥጋኪ ዘኢጎንደየ በምስካብ።","lang":"gez"},{"type":"paragraph","text":"እስመ አንሥኦ ፍጡነ መንፈሰ ሕይወቱ ለአብ።","lang":"gez"},{"type":"paragraph","text":"ኢይትነከር ለኪ ማርያም አድኅኖተ ጻድቃን ሕዝብ።","lang":"gez"},{"type":"paragraph","text":"እመሰ አድኃንኪ ኃጥኣነ በኪዳንኪ ጥበብ።","lang":"gez"},{"type":"paragraph","text":"ዝኬ መንክር ወጥቀ ዕፁብ።","lang":"gez"},{"type":"paragraph","text":"ሰላም ለግንዘተ ሥጋኪ በመዋጥሐክታን ወከርቤ።","lang":"gez"},{"type":"paragraph","text":"ላዕለ እደ ጴጥሮስ ብእሴ ይባቤ።","lang":"gez"},{"type":"paragraph","text":"ተሣህልኒ ማርያም ወኢትበልኒ አመ ምንዳቤ።","lang":"gez"},{"type":"paragraph","text":"ለምንት ተአኲት ኪዳንየ ወረድኤትየ ዐቃቤ።","lang":"gez"},{"type":"paragraph","text":"ቅብዐ ኃጥኣን አኮኑ ኢይትቀባዕ ዕቤ።","lang":"gez"},{"type":"paragraph","text":"ሰላም ለመቃብርኪ እንተ ይትጋብኡ ባቲ።","lang":"gez"},{"type":"paragraph","text":"አሕዛበ ምድር ኲሎሙ እስመ ምክሆሙ ይእቲ","lang":"gez"},{"type":"paragraph","text":"ማርያም ብጽሒ በሰዓተ ሞትየ ለመዋቲ።","lang":"gez"},{"type":"paragraph","text":"እምነፍሰ ክርስቲያን አኮኑ ሶበ ትመውት አሐቲ","lang":"gez"},{"type":"paragraph","text":"ለናዝዞታ ፍጡነ ትበጽሒ አንቲ።","lang":"gez"},{"type":"paragraph","text":"ሰላም ለትንሣኤ ሥጋኪ ለትንሣኤ ክርስቶስ አምሳሊሁ።","lang":"gez"},{"type":"paragraph","text":"አንቀጸ መቃብር ዝጉሐ እንዘ ኢያርኁ።","lang":"gez"},{"type":"paragraph","text":"ማርያም አንቲ ለአዳም ጥንተ ተስፋሁ።","lang":"gez"},{"type":"paragraph","text":"ሶበ አኮ ኪዳንኪ ወጸሎትኪ ምስሌሁ።","lang":"gez"},{"type":"paragraph","text":"ውስተ ዕመቀ ኅጒል እምኮነ በነፍሱ ወሥጋሁ።","lang":"gez"},{"type":"paragraph","text":"ሰላም ለፍልሰተ ሥጋኪ ኀበ ሕንፃ ሕይወት ተሐደሰ።","lang":"gez"},{"type":"paragraph","text":"እምቅድመ ዝኒ ኀቤሁ ሥጋ ወልድኪ ፈለሰ።","lang":"gez"},{"type":"paragraph","text":"ቤዛዊተ ዓለም ማርያም አስተበቊዓኪ አንሰ።","lang":"gez"},{"type":"paragraph","text":"ትቤዝዊ በኪዳንኪ ዘዚኣየ ነፍሰ።","lang":"gez"},{"type":"paragraph","text":"እስመ በሥራይኪ ለቊስልየ ቀባዕክኒ ፈውሰ።","lang":"gez"},{"type":"paragraph","text":"ነአኲቶ ለእግዝአብሔር ለዘጸውዓነ በጽዋዔ።","lang":"gez"},{"type":"paragraph","text":"ተዝካረ ኪዳንኪ ንግበር ማዕከለ ምንዱባን ጉባዔ።","lang":"gez"},{"type":"paragraph","text":"ተመጠዊዮ ባሕቱ ማርያም አመ ትንሣኤ።","lang":"gez"},{"type":"paragraph","text":"ወአንብሪ በርእሰ ነፍሱ አክሊላተ መንግሥት ሱባዔ።","lang":"gez"},{"type":"paragraph","text":"ለነባቤ ዝንቱ ድርሳን አርብዓ ወክልኤ።","lang":"gez"},{"type":"paragraph","text":"ስብሐት ለኪ ማርያም በስብሐተ አብ ወላዲ።","lang":"gez"},{"type":"paragraph","text":"ስብሐት ለኪ ማርያም በስብሐተ ወልድ ተወላዲ።","lang":"gez"},{"type":"paragraph","text":"ስብሐት ለኪ ማርያም በስብሐተ መንፈስ ቅዱስ ኢተወላዲ።","lang":"gez"},{"type":"paragraph","text":"ተማኅፀንኩ በኪዳንኪ ለዓለመ ዓለም ወዓዲ።","lang":"gez"},{"type":"paragraph","text":"ከመ ትዕቀብኒ ወትረ እምሰይጣን ረዋዲ።","lang":"gez"},{"type":"paragraph","text":"ሰላም ለኪ ኪዳነ ምሕረት ተስፋየ ዘታጸድቂ ኃጥአ።","lang":"gez"},{"type":"paragraph","text":"ወዘተኅሥሢ አሐደ በግዐ። ዘተገድፈ እምነ ተስዓ።","lang":"gez"},{"type":"paragraph","text":"ሰላም ለኪ ኪዳነ ምሕረት ሐውልት ዘተከለኪ","lang":"gez"},{"type":"paragraph","text":"እግዚእ ትእምርተ አድኅኖ ትኩኒ ለኲሉ ኃጥእ።","lang":"gez"},{"type":"paragraph","text":"ፍቅረ ዘያጸንዕ","lang":"gez"},{"type":"paragraph","text":"ሰላም ለኪ ኪዳነ ምሕረት ወርቅ መክብበ ኲሉ ንዋይ።","lang":"gez"},{"type":"paragraph","text":"አንቲ ውእቱ መዝገበ ነዳይ። ወብዕል ዘበሰማይ።","lang":"gez"},{"type":"paragraph","text":"ሰላም ለኪ ኪዳነ ምሕረት በማይ ዘታጸንኒ መድሎተ።","lang":"gez"},{"type":"paragraph","text":"ተአምኖትየ ብኪ ረስዪ ሊተ ፤ ገድለ ወትሩፋተ።","lang":"gez"},{"type":"paragraph","text":"ሰላም ለኪ ሶበ ስእንኩ ጸዲቀ በምግባረ ሠናይ ወገድል።","lang":"gez"},{"type":"paragraph","text":"አስመኩ ብኪ ኪዳነ ድንግል መድኃኒተ ነፍስየ እምነ ኃጒል።","lang":"gez"},{"type":"paragraph","text":"ሰላም ለኪ ኪዳነ ምሕረት ዐረቦነ መንግስት ዘላዕሉ።","lang":"gez"},{"type":"paragraph","text":"ዘያፈቅረኪ በተስፋ ይሄሉ።","lang":"gez"},{"type":"paragraph","text":"ሰላም ለኪ በከመ ኪዳንኪ ቤተ ለዘሐነፀ ገብርኪ ወለዘጸለየ","lang":"gez"},{"type":"paragraph","text":"በስምኪ ማርያም ፈትቲ እምበረከትኪ ወሰአሊ ኀበ ኄር ወልድኪ።","lang":"gez"},{"type":"paragraph","text":"ኦ እግዝእትየ ማርያም ዕቀብኒ ወአድኅንኒ በኪዳንኪ እምእደ ሰብእ እኩያን ወእምኃይለ አጋንንት ፀዋጋን ሊተ ለ .....................","lang":"gez"}]}]}