{"id":"ce72a3c442","title":"መልክአ ኪዳነ ምሕረት","shelf":"melkie","chapters":[{"number":1,"title":"","blocks":[{"type":"heading","text":"መልክአ ኪዳነ ምሕረት","level":1,"lang":"gez"},{"type":"heading","text":"መቅድም","level":2,"lang":"gez"},{"type":"paragraph","text":"እግዝአብሔር አብ","lang":"gez"},{"type":"paragraph","text":"እግዝአብሔር አብ ወኅቤ ብርሃን ዘይሤለስ በአካሉ።","lang":"gez"},{"type":"paragraph","text":"እንዘ ተዋህዶ ያጸንዕ በመለኮቱ ወኃይሉ።","lang":"gez"},{"type":"paragraph","text":"ዐይነ ልቡናየ ያብርህ በማኅቶተ ጥበብ ሥነ ጸዳሉ።","lang":"gez"},{"type":"paragraph","text":"ከመ ይርአይ ገጸ ነገር ለኪዳንኪ ዘይደሉ።","lang":"gez"},{"type":"paragraph","text":"ማርያም እግዝእተ ኲሉ ዘታሕቱ ወላዕሉ።","lang":"gez"},{"type":"paragraph","text":"ሰላም ለዝክረ ስምኪ ዘአስተማሰልዎ በኮከብ።","targetAnatomy":"ዝክረ ስምኪ","index":1,"lang":"gez"},{"type":"paragraph","text":"ሶበ ብርሃኖ ተከድኑ ጽልሙታነ ራእይ ሕዝብ።","targetAnatomy":"ማኅሌት","index":2,"lang":"gez"},{"type":"paragraph","text":"ኪዳነ አምላክ ማርያም ወተስፋ መድኃኒት ዘዐርብ።","targetAnatomy":"ማኅሌት","index":3,"lang":"gez"},{"type":"paragraph","text":"ተናዘዘ ብኪ አኮኑ ኅሊና ቀዳማይ አብ።","targetAnatomy":"ማኅሌት","index":4,"lang":"gez"},{"type":"paragraph","text":"አመ እምገነቱ ተሰደ በኅዘን ዕፁብ።","targetAnatomy":"ማኅሌት","index":5,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለስእርተ ርእስኪ ዘፈትለ ሜላት ዘውጋ።","targetAnatomy":"ስእርተ ርእስኪ","index":6,"lang":"gez"},{"type":"paragraph","text":"ወምልዕት ይእቲ እምጠለ ሰማይ እንበለ ንትጋ።","targetAnatomy":"ማኅሌት","index":7,"lang":"gez"},{"type":"paragraph","text":"ለዘተካየደኪ ማርያም ኪዳነ ምሕረት ቅድመ","targetAnatomy":"ማኅሌት","index":8,"lang":"gez"},{"type":"paragraph","text":"እንግልጋ።","targetAnatomy":"ማኅሌት","index":9,"lang":"gez"},{"type":"paragraph","text":"ሰአሊዮ ሕይወተ ነፍስየ ይጸግወኒ በጸጋ።","targetAnatomy":"ማኅሌት","index":10,"lang":"gez"},{"type":"paragraph","text":"አምሳለ ኤልያስ አኮ ያሕይወኒ በሥጋ።","targetAnatomy":"ማኅሌት","index":11,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለርእስኪ ዘሀሎ ወይሄሉ።","targetAnatomy":"ርእስኪ ዘሀሎ","index":12,"lang":"gez"},{"type":"paragraph","text":"ዲበ ጠባይዓት ኲሉ።","targetAnatomy":"ማኅሌት","index":13,"lang":"gez"},{"type":"paragraph","text":"ተካየድኒ ማርያም በኪዳንኪ ዘይደሉ።","targetAnatomy":"ማኅሌት","index":14,"lang":"gez"},{"type":"paragraph","text":"ምስለ ሞትሰ ተካየድነ ወተመሐልነ ዘይብሉ።","targetAnatomy":"ማኅሌት","index":15,"lang":"gez"},{"type":"paragraph","text":"ከንቶ ነበቡ ወነፍሶሙ ኅጒሉ።","targetAnatomy":"ማኅሌት","index":16,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለገጽኪ ገጸ ቅድስና ስቡሕ።","targetAnatomy":"ገጽኪ ገጸ","index":17,"lang":"gez"},{"type":"paragraph","text":"ዘይኤድም ሥኑ እምጸዳለ ፀሐይ ወወርኅ።","targetAnatomy":"ማኅሌት","index":18,"lang":"gez"},{"type":"paragraph","text":"ትእምርተ ኪዳን ማርያም ወቀስተ ደመና ብሩህ።","targetAnatomy":"ማኅሌት","index":19,"lang":"gez"},{"type":"paragraph","text":"እምኀበ አምላክ መሐሪ እምአመ ነሥአኪ ኖኅ።","targetAnatomy":"ማኅሌት","index":20,"lang":"gez"},{"type":"paragraph","text":"አማስኖታ ለምድር ኢደገመ አይኅ።","targetAnatomy":"ማኅሌት","index":21,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለቀራብትኪ ንጻሬ አዕይንት ለዑቃቤ።","targetAnatomy":"ማኅሌት","index":22,"lang":"gez"},{"type":"paragraph","text":"እለ ሥዩማት እማንቱ ህየንተ ምስዋር ወግልባቤ።","targetAnatomy":"ማኅሌት","index":23,"lang":"gez"},{"type":"paragraph","text":"ማርያም በሊዮ ለዘወለድኪዮ በኢሩካቤ።","targetAnatomy":"ማኅሌት","index":24,"lang":"gez"},{"type":"paragraph","text":"አይቴ ቃልከ እግዚኦ እምሕር ለኪ ዘይቤ።","targetAnatomy":"ማኅሌት","index":25,"lang":"gez"},{"type":"paragraph","text":"ለእመኃጥኣን ጸውዑ ስመኪ ነባቤ።","targetAnatomy":"ማኅሌት","index":26,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለአዕይንትኪ አምሳለ ክልኤቲ ቀናዲል።","targetAnatomy":"አዕይንትኪ አምሳለ","index":27,"lang":"gez"},{"type":"paragraph","text":"እንተ ሰቀሎን ኬኒያ በማኅፈደ ሥጋ ልዑል።","targetAnatomy":"ማኅሌት","index":28,"lang":"gez"},{"type":"paragraph","text":"ማርያም አንቲ ነቅዐ ተራኅርኆ ወሣህል።","targetAnatomy":"ማኅሌት","index":29,"lang":"gez"},{"type":"paragraph","text":"አድኅንኒ በኪዳንኪ ወባልሕኒ እምኅጒል።","targetAnatomy":"ማኅሌት","index":30,"lang":"gez"},{"type":"paragraph","text":"እስመ ዘእንበሌኪ አልቦ አድኅኖ ዘይክል።","targetAnatomy":"ማኅሌት","index":31,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለአዕዛንኪ እለ ተበሥራ ኪዳነ።","targetAnatomy":"አዕዛንኪ እለ","index":32,"lang":"gez"},{"type":"paragraph","text":"እምአፈ ፈጣሪ ወልድኪ ዘባሕርየኪ ተከድነ።","targetAnatomy":"ማኅሌት","index":33,"lang":"gez"},{"type":"paragraph","text":"አምሕለኪ ማርያም ከመ ኢታርእይኒ ደይነ።","targetAnatomy":"ማኅሌት","index":34,"lang":"gez"},{"type":"paragraph","text":"እንበለ ምግባር ባሕቱ እመ ኢይጸድቅ አነ።","targetAnatomy":"ማኅሌት","index":35,"lang":"gez"},{"type":"paragraph","text":"ቦኑ ለከንቱ ኪዳንኪ ኮነ።","targetAnatomy":"ማኅሌት","index":36,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለመላትሕኪ ጽጌያተ ሮማን እለ ይመስላ።","targetAnatomy":"መላትሕኪ ጽጌያተ","index":37,"lang":"gez"},{"type":"paragraph","text":"ባሕቱ መጽለዋ ለእሳተ አንብዕ በነበልባላ።","targetAnatomy":"ማኅሌት","index":38,"lang":"gez"},{"type":"paragraph","text":"በኪዳንኪ ማርያም አዕርግኒ ዐፀደ ተድላ።","targetAnatomy":"ማኅሌት","index":39,"lang":"gez"},{"type":"paragraph","text":"ወይ ለነዓሌ ለነ አመ ውስተ ደይን ይብላ።","targetAnatomy":"ማኅሌት","index":40,"lang":"gez"},{"type":"paragraph","text":"ነፍሳተ ክልኤቲ አኃት ሐሊባ ወሐላ።","targetAnatomy":"ማኅሌት","index":41,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለአዕናፍኪ","targetAnatomy":"ማኅሌት","index":42,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለአዕናፍኪ መሳክወ ሕይወት ምንታዌ።","targetAnatomy":"ማኅሌት","index":43,"lang":"gez"},{"type":"paragraph","text":"ዘአስተዋደዶን አምላክ በአጽባዕተ ጥበብ ወልባዌ።","targetAnatomy":"ማኅሌት","index":44,"lang":"gez"},{"type":"paragraph","text":"ማርያም ሕጽርኒ በኃይለ ኪዳንኪ እምንሳዌ።","targetAnatomy":"ማኅሌት","index":45,"lang":"gez"},{"type":"paragraph","text":"ወቀጥቅጢ ርእሶ በአብትረ ሕማም ወደዌ።","targetAnatomy":"ማኅሌት","index":46,"lang":"gez"},{"type":"paragraph","text":"ለእመ አፉሁ አብቀወ የሐጠኒ አርዌ።","targetAnatomy":"ማኅሌት","index":47,"lang":"amh"},{"type":"paragraph","text":"ሰላም ለከናፍርኪ በእንተ ኃጥኣን እለ ሰአላ።","targetAnatomy":"ከናፍርኪ በእንተ","index":48,"lang":"gez"},{"type":"paragraph","text":"እምኀበ አምላክ መሐሪ ኪዳነ ምሕረት ወመሐላ።","targetAnatomy":"ማኅሌት","index":49,"lang":"gez"},{"type":"paragraph","text":"እስከ ጎልጎታ ማርያም አመ ገይሦትኪ እምገሊላ።","targetAnatomy":"ማኅሌት","index":50,"lang":"gez"},{"type":"paragraph","text":"ለጽድቀ ዛቲ ኪዳንኪ ለለይከውን በዓላ።","targetAnatomy":"ማኅሌት","index":51,"lang":"gez"},{"type":"paragraph","text":"ዲበ ርእሰ ኃጥእ ገብርኪ አንብሪ አክሊላ።","targetAnatomy":"ማኅሌት","index":52,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለአፉኪ አፈ በረከት ትሩፍ።","targetAnatomy":"አፉኪ አፈ","index":53,"lang":"gez"},{"type":"paragraph","text":"ወአንቀጸ ቅዱስ መጽሐፍ።","targetAnatomy":"ማኅሌት","index":54,"lang":"gez"},{"type":"paragraph","text":"ተማኅፀንኩ ማርያም በኪዳንኪ ውኩፍ።","targetAnatomy":"ማኅሌት","index":55,"lang":"gez"},{"type":"paragraph","text":"ኢይትኅፈር ቅድመ ወልድኪ ወመላእክቲሁ አዕላፍ።","targetAnatomy":"ማኅሌት","index":56,"lang":"gez"},{"type":"paragraph","text":"አመ ሥርወ ልሳን ይትመተር ወይትኅተም አፍ።","targetAnatomy":"ማኅሌት","index":57,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለአስናንኪ ከመ መራዕይ እለ ተቀርፃ። ወለ","targetAnatomy":"አስናንኪ ከመ","index":58,"lang":"gez"},{"type":"paragraph","text":"ወፅኣ እምሕፃብ እንዘ ይትባየጻ።","targetAnatomy":"ማኅሌት","index":59,"lang":"gez"},{"type":"paragraph","text":"ማርያም ንሥእኒ ዐሥራተ ኪዳን ህየንተ ሞፃ","targetAnatomy":"ማኅሌት","index":60,"lang":"gez"},{"type":"paragraph","text":"ወለእድውየ ግብፃዊ ዘፍትወተ ልቡ ዓመፃ።","targetAnatomy":"ማኅሌት","index":61,"lang":"gez"},{"type":"paragraph","text":"መዝራዕተ ጸሎትኪ ሙሴ ይድፍኖ በኆፃ።","targetAnatomy":"ማኅሌት","index":62,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለልሳንኪ ዘአፈድፈደ ቅዳሴ።","targetAnatomy":"ልሳንኪ ዘአፈድፈደ","index":63,"lang":"gez"},{"type":"paragraph","text":"እምካህናተ ሰማይ ሱራፌል እለ ይቀውሙ ቅድመ ሥላሴ","targetAnatomy":"ማኅሌት","index":64,"lang":"gez"},{"type":"paragraph","text":"አዘክሪ ሊተ ማርያም ተዝካረ ኪዳንኪ አመ ድምሳሴ።","targetAnatomy":"ማኅሌት","index":65,"lang":"gez"},{"type":"paragraph","text":"በእንተ እስራኤል በገዳም ከመ አዘከረ አውሴ።","targetAnatomy":"ማኅሌት","index":66,"lang":"gez"},{"type":"paragraph","text":"ኪዳነ ሠለስቱ አበው ወጽድቆ ለሙሴ።","targetAnatomy":"ማኅሌት","index":67,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለቃልኪ ተሰጣዌ ቃል እምቃሉ።","targetAnatomy":"ቃልኪ ተሰጣዌ","index":68,"lang":"gez"},{"type":"paragraph","text":"ለመልአከ ብሥራት ገብርኤል ዘጸዳለ ብርሃን ሠርጎ መንዲሉ።","targetAnatomy":"ማኅሌት","index":69,"lang":"gez"},{"type":"paragraph","text":"ማርያም ቅድስት ለእግዝአብሔር መካነ ኃይሉ።","targetAnatomy":"ማኅሌት","index":70,"lang":"gez"},{"type":"paragraph","text":"እንቋዕ እንቋዕ ወሀበኪ ኪዳነ ምሕረት ወሣህሉ።","targetAnatomy":"ማኅሌት","index":71,"lang":"gez"},{"type":"paragraph","text":"በዘቦቱ ጸዲቀ ኃጥኣን ይክሉ።","targetAnatomy":"ማኅሌት","index":72,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለእስትንፋስኪ ነፋሰ ጥዒና ፈዋሲ።","targetAnatomy":"እስትንፋስኪ ነፋሰ","index":73,"lang":"gez"},{"type":"paragraph","text":"ነፍሳተ ኃጥኣን ሰብእ እለ ቌስሉ በኅምዘ ከይሲ።","targetAnatomy":"ማኅሌት","index":74,"lang":"gez"},{"type":"paragraph","text":"በኪዳንኪ ማርያም ኃጣውእየ ደምስሲ።","targetAnatomy":"ማኅሌት","index":75,"lang":"gez"},{"type":"paragraph","text":"እንበለ ኪዳንኪሰ ወመስቀለ ክርስቶስ ወራሲ።","targetAnatomy":"ማኅሌት","index":76,"lang":"gez"},{"type":"paragraph","text":"አልቦ እምሲኦል ዘይድኅን ብእሲ።","targetAnatomy":"ማኅሌት","index":77,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለጒርዔኪ ሠናይ ወአዳም።","targetAnatomy":"ጒርዔኪ ሠናይ","index":78,"lang":"gez"},{"type":"paragraph","text":"እንተ ይትፈለጡ ቦቱ ጸዋትወ ምረር ወጣዕም።","targetAnatomy":"ማኅሌት","index":79,"lang":"gez"},{"type":"paragraph","text":"ምንተ እግበር ለኪ ማርያም እስመ ኃይልየ ድኩም።","targetAnatomy":"ማኅሌት","index":80,"lang":"gez"},{"type":"paragraph","text":"ዓፀበኒ ግብር እምኲለሄ ወፀበበኒ ዓለም።","targetAnatomy":"ማኅሌት","index":81,"lang":"gez"},{"type":"paragraph","text":"ባሕቱ በኪዳንኪ ናዝዝኒ እም።","targetAnatomy":"ማኅሌት","index":82,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለክሳድኪ ዘማኅፈደ ዳዊት ተርእዮታ። ዲበ","targetAnatomy":"ክሳድኪ ዘማኅፈደ","index":83,"lang":"gez"},{"type":"paragraph","text":"ተልፍዮስ ጠቢባን ዘአስተናደፉ መሠረታ ማርያም","targetAnatomy":"ማኅሌት","index":84,"lang":"gez"},{"type":"paragraph","text":"በሊ ውስተ ዕዝነ ነፍስየ ለናዝዞታ።","targetAnatomy":"ማኅሌት","index":85,"lang":"gez"},{"type":"paragraph","text":"ለምንት ብዙኃ ትሠርሒ ነፍስየ ገብርየ ማርታ","targetAnatomy":"ማኅሌት","index":86,"lang":"gez"},{"type":"paragraph","text":"እስመ ኅዳጥ የአክል እምብዙኅ ሐተታ።","targetAnatomy":"ማኅሌት","index":87,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለመታክፍትኪ ግዕዛነ በረከት እለ ተወክፋ።","targetAnatomy":"መታክፍትኪ ግዕዛነ","index":88,"lang":"gez"},{"type":"paragraph","text":"እምቅኔ መርገም ወዘለፋ።","targetAnatomy":"ማኅሌት","index":89,"lang":"gez"},{"type":"paragraph","text":"ማርያም ጹርኒ ለጽድቀ ኪዳንኪ ዲበ መትከፋ።","targetAnatomy":"ማኅሌት","index":90,"lang":"gez"},{"type":"paragraph","text":"ወንሥእኒ ዐሥራተ እድ እመርዔተ ወልድኪ አልፋ።","targetAnatomy":"ማኅሌት","index":91,"lang":"gez"},{"type":"paragraph","text":"እስመ ሃይማኖትየ አንቲ ወዘብየ ተስፋ።","targetAnatomy":"ማኅሌት","index":92,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለዘባንኪ በወርኃ ተሰዶ ቀዲሙ።","targetAnatomy":"ዘባንኪ በወርኃ","index":93,"lang":"gez"},{"type":"paragraph","text":"ምዕራፈ አምላክ ዘኮነ ውስተ ፍኖተ ቊስቋም ጊዜ ድካሙ።","targetAnatomy":"ማኅሌት","index":94,"lang":"gez"},{"type":"paragraph","text":"ማርያም ስመኪ ለዘፆረ መልዕልተ ስሙ።","targetAnatomy":"ማኅሌት","index":95,"lang":"gez"},{"type":"paragraph","text":"በእለተ ኲነኔ ደኃሪት እመ ኢያስለጠ ደሙ።","targetAnatomy":"ማኅሌት","index":96,"lang":"gez"},{"type":"paragraph","text":"ዐሥራተ ምሕረት ንሥኢዮ መሐሪት እሙ።","targetAnatomy":"ማኅሌት","index":97,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለእንግድዓኪ ወለሕፅንኪ ካልእታ።","targetAnatomy":"እንግድዓኪ ወለሕፅንኪ","index":98,"lang":"gez"},{"type":"paragraph","text":"ወለአዕዳውኪ መንታ።","targetAnatomy":"ማኅሌት","index":99,"lang":"gez"},{"type":"paragraph","text":"አምሕለኪ ማርያም በነጸፍጻፈ ደም ዘጎልጎታ","targetAnatomy":"ማኅሌት","index":100,"lang":"gez"},{"type":"paragraph","text":"ለነፍስየ ምስለ ነፍስኪ አስተዳልዊ መክፈልታ።","targetAnatomy":"ማኅሌት","index":101,"lang":"gez"},{"type":"paragraph","text":"አመ መሬታዊት ሥጋየ ትትከደን መሬታ።","targetAnatomy":"ማኅሌት","index":102,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለመዛርዕኪ ወለኲርናዕኪ ምፅንጋዕ።","targetAnatomy":"መዛርዕኪ ወለኲርናዕኪ","index":103,"lang":"gez"},{"type":"paragraph","text":"እለ ሐቀፋሁ ለክርስቶስ ባርሕየ መለኮት ኅቡዕ።","targetAnatomy":"ማኅሌት","index":104,"lang":"gez"},{"type":"paragraph","text":"ማርያም ኅሪት እምነ መላእክት ወሰብእ።","targetAnatomy":"ማኅሌት","index":105,"lang":"gez"},{"type":"paragraph","text":"ተዝካረኪ ለእመ ገብረ በተአምኖ ጽኑዕ።","targetAnatomy":"ማኅሌት","index":106,"lang":"gez"},{"type":"paragraph","text":"በመንግሥተ ሰማይ ምስሌኪ ይነግሥ ኃጥእ።","targetAnatomy":"ማኅሌት","index":107,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለእመታትኪ በመቅደሰ አምላክ ቀዋሚ።","targetAnatomy":"እመታትኪ በመቅደሰ","index":108,"lang":"gez"},{"type":"paragraph","text":"እለ አሠነያ ወርቀ ምስለ ፈትለ ሜላት ግብረ አናሚ።","targetAnatomy":"ማኅሌት","index":109,"lang":"gez"},{"type":"paragraph","text":"ማርያም ላዕሌየ ኪዳነ ምሕረት ፈጽሚ","targetAnatomy":"ማኅሌት","index":110,"lang":"gez"},{"type":"paragraph","text":"ወትትሊ ፀረ ነፍስየ እስመ ውእቱ ረጋሚ።","targetAnatomy":"ማኅሌት","index":111,"lang":"gez"},{"type":"paragraph","text":"ከመ በጥበቡ ሰሎሞን ቀተሎ ለሳሚ።","targetAnatomy":"ማኅሌት","index":112,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለእራኅኪ ተመጣዌ ኅብስት ወማይ።","targetAnatomy":"እራኅኪ ተመጣዌ","index":113,"lang":"gez"},{"type":"paragraph","text":"ሶበ ያመጽኡ ለኪ መላእክተ ሰማይ።","targetAnatomy":"ማኅሌት","index":114,"lang":"gez"},{"type":"paragraph","text":"እንዘ ሀሎኪ ማርያም በመቅደሰ ኦሪት ዐባይ።","targetAnatomy":"ማኅሌት","index":115,"lang":"gez"},{"type":"paragraph","text":"ይትወከፍ ሊተ ኪዳንኪ ከመ መሥዋዕተ ሠርክ ኅሩይ።","targetAnatomy":"ማኅሌት","index":116,"lang":"gez"},{"type":"paragraph","text":"ለእመ ኅፍነማይ አስተይኩ ለጽሙዕ ነዳይ።","targetAnatomy":"ማኅሌት","index":117,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለአጻብዕኪ ወለአጽፋርኪ ጸዐድው።","targetAnatomy":"አጻብዕኪ ወለአጽፋርኪ","index":118,"lang":"gez"},{"type":"paragraph","text":"ወለአጥባትኪ ክልኤ አንቅዕተ ሐሊብ ቅድው።","targetAnatomy":"ማኅሌት","index":119,"lang":"gez"},{"type":"paragraph","text":"ማርያም ጽጌ ዘዘመንኪ መፀው።","targetAnatomy":"ማኅሌት","index":120,"lang":"gez"},{"type":"paragraph","text":"ተማኅፀንኩ በአጥባትኪ ወበስንኪ ፍትው።","targetAnatomy":"ማኅሌት","index":121,"lang":"gez"},{"type":"paragraph","text":"በኃይለ ኪዳንኪ እድኅን እምእሳት ድልው።","targetAnatomy":"ማኅሌት","index":122,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለገበዋትኪ እመንገለ ለፌ ወለፌ።","targetAnatomy":"ገበዋትኪ እመንገለ","index":123,"lang":"gez"},{"type":"paragraph","text":"እለ ተረሰያ ደርገ ሐመልማለ ወርቅ ኢኃላፌ።","targetAnatomy":"ማኅሌት","index":124,"lang":"gez"},{"type":"paragraph","text":"ማርያም ምጥቅኒ በገቦ ኪዳንኪ ምስለ ሑቃፌ","targetAnatomy":"ማኅሌት","index":125,"lang":"gez"},{"type":"paragraph","text":"አመ ይወርዱ ኃጥኣን በብሔረ ጽልመት ጸናፌ።","targetAnatomy":"ማኅሌት","index":126,"lang":"gez"},{"type":"paragraph","text":"እስመ በሕይወቶሙ ጸልዑ ዘጻድቃን ሱታፌ።","targetAnatomy":"ማኅሌት","index":127,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለከርሥኪ ዘከርሠ መላእክት ዘውጉ።","targetAnatomy":"ከርሥኪ ዘከርሠ","index":128,"lang":"gez"},{"type":"paragraph","text":"ወኅብስተ ሰማይ ወትረ ዘይሴሰይ ዐቅመ ምዕራጉ።","targetAnatomy":"ማኅሌት","index":129,"lang":"gez"},{"type":"paragraph","text":"ማርያም ጽዮን ለእግዝአብሔር ታቦተ ሕጉ።","targetAnatomy":"ማኅሌት","index":130,"lang":"gez"},{"type":"paragraph","text":"ያንጽሐኒ እምፍቅረ ወርቅ ለማየ ኪዳንኪ አይጉ","targetAnatomy":"ማኅሌት","index":131,"lang":"gez"},{"type":"paragraph","text":"እስመ ፍቅረ ንዋይ ተብህለ ለሰይጣን ኤረጉ።","targetAnatomy":"ማኅሌት","index":132,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለልብኪ ስንዕወ ኲልያት ወኅሊና።","targetAnatomy":"ልብኪ ስንዕወ","index":133,"lang":"gez"},{"type":"paragraph","text":"ለአማዑትኪ ሰላም፤ ወለንዋየ ውስጥኪ በዕሪና","targetAnatomy":"ማኅሌት","index":134,"lang":"gez"},{"type":"paragraph","text":"ውስተ ምድረ ርስት አብእኒ ማርያም ቀስተ ደመና።","targetAnatomy":"ማኅሌት","index":135,"lang":"gez"},{"type":"paragraph","text":"በብርሃነ እሳት ኪዳንኪ እንዘ ትመርህኒ ፍና","targetAnatomy":"ማኅሌት","index":136,"lang":"gez"},{"type":"paragraph","text":"ወትሴስይኒ እምፍቅርኪ መና።","targetAnatomy":"ማኅሌት","index":137,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለኅንብርትኪ ምሳሌ ፍሑቅ ማዕከክ።","targetAnatomy":"ኅንብርትኪ ምሳሌ","index":138,"lang":"gez"},{"type":"paragraph","text":"ወለማኅፀንኪ ንጹሕ ምስለ ሐቌኪ ቡሩክ።","targetAnatomy":"ማኅሌት","index":139,"lang":"gez"},{"type":"paragraph","text":"ማርያም ቅድስት ወላዲተ ክርስቶስ አምላክ።","targetAnatomy":"ማኅሌት","index":140,"lang":"gez"},{"type":"paragraph","text":"ተዐየኒ ዐውደ ነፍስየ እስከ ሣልሳዊ ፈለክ።","targetAnatomy":"ማኅሌት","index":141,"lang":"gez"},{"type":"paragraph","text":"አመ ተቃውማ በአየር ቀናዒ መልአክ።","targetAnatomy":"ማኅሌት","index":142,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለድንግልናኪ መክብበ ሕዋሳት ኅምስ።","targetAnatomy":"ድንግልናኪ መክብበ","index":143,"lang":"gez"},{"type":"paragraph","text":"ወለአቊያጽኪ ክልኤ አዕማደ ነባቢት መቅደስ።","targetAnatomy":"ማኅሌት","index":144,"lang":"gez"},{"type":"paragraph","text":"ማርያም ታቦት ወጽላተ ኪዳን ሐዲስ።","targetAnatomy":"ማኅሌት","index":145,"lang":"gez"},{"type":"paragraph","text":"ቅብዕኒ ርጢነ ደም እስከ ሰኮና እግር ወርእስ","targetAnatomy":"ማኅሌት","index":146,"lang":"gez"},{"type":"paragraph","text":"እስመ ጾም ትፌውስ ሕማማ ለነፍስ።","targetAnatomy":"ማኅሌት","index":147,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለአብራክኪ ጊዜ አስተብርኮ ወተንብሎ።","targetAnatomy":"አብራክኪ ጊዜ","index":148,"lang":"gez"},{"type":"paragraph","text":"ምስለ አእጋርኪ ደርገ እለ ይሰግዳ በኢያብጥሎ።","targetAnatomy":"ማኅሌት","index":149,"lang":"amh"},{"type":"paragraph","text":"ማርያም ለአብ እንተ ተሳተፍኪ ቃሎ።","targetAnatomy":"ማኅሌት","index":150,"lang":"gez"},{"type":"paragraph","text":"ሰአሊዮ ሕይወተ ነፍስ ይጸግወኒ ሣህሎ።","targetAnatomy":"ማኅሌት","index":151,"lang":"gez"},{"type":"paragraph","text":"አመ ውስተ እሳት ይወዲ ኃጥኣነ ኲሎ።","targetAnatomy":"ማኅሌት","index":152,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለሰኮናኪ ወለመከየድኪ እለ ሖራ።","targetAnatomy":"ሰኮናኪ ወለመከየድኪ","index":153,"lang":"gez"},{"type":"paragraph","text":"እስከ ደብረ ቊስቋም ለደቂቅ አመ ቀተልዎ ሐራ።","targetAnatomy":"ማኅሌት","index":154,"lang":"gez"},{"type":"paragraph","text":"ለአምላከ ሰማይ በሊዮ ማርያም ወለተ ቅስራ።","targetAnatomy":"ማኅሌት","index":155,"lang":"gez"},{"type":"paragraph","text":"አማንኑ ትኴንና በእንተ ሠላስ ነገራ።","targetAnatomy":"ማኅሌት","index":156,"lang":"gez"},{"type":"paragraph","text":"ለዘታፈቅረከ ነፍስ በኲሉ ምግባራ።","targetAnatomy":"ማኅሌት","index":157,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለአጻብዕኪ አቅርንተ አዕጋር ክልኤቲ።","targetAnatomy":"አጻብዕኪ አቅርንተ","index":158,"lang":"amh"},{"type":"paragraph","text":"ወለአጽፋሪሆን ለለአሐቲ።","targetAnatomy":"ማኅሌት","index":159,"lang":"gez"},{"type":"paragraph","text":"በኪዳንኪ ማርያም ኃጢአትየ ክብቲ።","targetAnatomy":"ማኅሌት","index":160,"lang":"gez"},{"type":"paragraph","text":"ሰብእሰ እንዘ ከማየ መዋቲ።","targetAnatomy":"ማኅሌት","index":161,"lang":"gez"},{"type":"paragraph","text":"በጽዋዐ ልሳን ደምየ ቀዲሖ ይሰቲ።","targetAnatomy":"ማኅሌት","index":162,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለቆምኪ አየረ ትሩፋት ዘሐፀኖ።","targetAnatomy":"ቆምኪ አየረ","index":163,"lang":"gez"},{"type":"paragraph","text":"ወዐውሎ ኃጢአት ዘኢያጽነኖ።","targetAnatomy":"ማኅሌት","index":164,"lang":"gez"},{"type":"paragraph","text":"ማርያም ክድንኒ በክንፈ ኪዳንኪ እምተኮንኖ።","targetAnatomy":"ማኅሌት","index":165,"lang":"gez"},{"type":"paragraph","text":"ሶበሰ ኪዳንኪ ምክንያተ ድኂን ኢኮኖ።","targetAnatomy":"ማኅሌት","index":166,"lang":"gez"},{"type":"paragraph","text":"ነፍሰ በላዔ ሰብእ በምንት እምክህለ አድኅኖ።","targetAnatomy":"ማኅሌት","index":167,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለመልክእኪ እመልክአ ሐና ወኤልሳቤጥ","targetAnatomy":"መልክእኪ እመልክአ","index":168,"lang":"gez"},{"type":"paragraph","text":"ዘብዑድ ሥኑ ወልምላሜሁ ፍሉጥ።","targetAnatomy":"ማኅሌት","index":169,"lang":"gez"},{"type":"paragraph","text":"ማርያም ቅድስት ድንግልተ አፍኣ ወውስጥ።","targetAnatomy":"ማኅሌት","index":170,"lang":"gez"},{"type":"paragraph","text":"ቤዛ ይኩነኒ ኪዳንኪ በገጸ ፈጣሪ ሥሉጥ።","targetAnatomy":"ማኅሌት","index":171,"lang":"gez"},{"type":"paragraph","text":"አመ ወርኅ ነጊድ የኃልቅ ወይጸራዕ ሤጥ።","targetAnatomy":"ማኅሌት","index":172,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለፀዓተ ነፍስኪ በነጽሮ ብርሃን ዘየሐቱ።","targetAnatomy":"ፀዓተ ነፍስኪ","index":173,"lang":"gez"},{"type":"paragraph","text":"መልአከ አፍርሆ ጸሊም እንበለ ያደንግጽኪ በጽላሎቱ።","targetAnatomy":"ማኅሌት","index":174,"lang":"gez"},{"type":"paragraph","text":"አምሕለኪ ማርያም ለእግዝአብሔር በመለኮቱ።","targetAnatomy":"ማኅሌት","index":175,"lang":"gez"},{"type":"paragraph","text":"ከመ ታድኅንኒ በኪዳንኪ እመደንግፃን ሠለስቱ","targetAnatomy":"ማኅሌት","index":176,"lang":"gez"},{"type":"paragraph","text":"አመ ይፈልጠኒ ሞት እምሥጋየ ዝንቱ።","targetAnatomy":"ማኅሌት","index":177,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለበድነ ሥጋኪ ዘኢጎንደየ በምስካብ።","targetAnatomy":"በድነ ሥጋኪ","index":178,"lang":"gez"},{"type":"paragraph","text":"እስመ አንሥኦ ፍጡነ መንፈሰ ሕይወቱ ለአብ።","targetAnatomy":"ማኅሌት","index":179,"lang":"gez"},{"type":"paragraph","text":"ኢይትነከር ለኪ ማርያም አድኅኖተ ጻድቃን ሕዝብ።","targetAnatomy":"ማኅሌት","index":180,"lang":"gez"},{"type":"paragraph","text":"እመሰ አድኃንኪ ኃጥኣነ በኪዳንኪ ጥበብ።","targetAnatomy":"ማኅሌት","index":181,"lang":"gez"},{"type":"paragraph","text":"ዝኬ መንክር ወጥቀ ዕፁብ።","targetAnatomy":"ማኅሌት","index":182,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለግንዘተ ሥጋኪ በመዋጥሐክታን ወከርቤ።","targetAnatomy":"ግንዘተ ሥጋኪ","index":183,"lang":"gez"},{"type":"paragraph","text":"ላዕለ እደ ጴጥሮስ ብእሴ ይባቤ።","targetAnatomy":"ማኅሌት","index":184,"lang":"gez"},{"type":"paragraph","text":"ተሣህልኒ ማርያም ወኢትበልኒ አመ ምንዳቤ።","targetAnatomy":"ማኅሌት","index":185,"lang":"gez"},{"type":"paragraph","text":"ለምንት ተአኲት ኪዳንየ ወረድኤትየ ዐቃቤ።","targetAnatomy":"ማኅሌት","index":186,"lang":"gez"},{"type":"paragraph","text":"ቅብዐ ኃጥኣን አኮኑ ኢይትቀባዕ ዕቤ።","targetAnatomy":"ማኅሌት","index":187,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለመቃብርኪ እንተ ይትጋብኡ ባቲ።","targetAnatomy":"መቃብርኪ እንተ","index":188,"lang":"gez"},{"type":"paragraph","text":"አሕዛበ ምድር ኲሎሙ እስመ ምክሆሙ ይእቲ","targetAnatomy":"ማኅሌት","index":189,"lang":"gez"},{"type":"paragraph","text":"ማርያም ብጽሒ በሰዓተ ሞትየ ለመዋቲ።","targetAnatomy":"ማኅሌት","index":190,"lang":"gez"},{"type":"paragraph","text":"እምነፍሰ ክርስቲያን አኮኑ ሶበ ትመውት አሐቲ","targetAnatomy":"ማኅሌት","index":191,"lang":"gez"},{"type":"paragraph","text":"ለናዝዞታ ፍጡነ ትበጽሒ አንቲ።","targetAnatomy":"ማኅሌት","index":192,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለትንሣኤ ሥጋኪ ለትንሣኤ ክርስቶስ አምሳሊሁ።","targetAnatomy":"ትንሣኤ ሥጋኪ","index":193,"lang":"gez"},{"type":"paragraph","text":"አንቀጸ መቃብር ዝጉሐ እንዘ ኢያርኁ።","targetAnatomy":"ማኅሌት","index":194,"lang":"gez"},{"type":"paragraph","text":"ማርያም አንቲ ለአዳም ጥንተ ተስፋሁ።","targetAnatomy":"ማኅሌት","index":195,"lang":"gez"},{"type":"paragraph","text":"ሶበ አኮ ኪዳንኪ ወጸሎትኪ ምስሌሁ።","targetAnatomy":"ማኅሌት","index":196,"lang":"gez"},{"type":"paragraph","text":"ውስተ ዕመቀ ኅጒል እምኮነ በነፍሱ ወሥጋሁ።","targetAnatomy":"ማኅሌት","index":197,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለፍልሰተ ሥጋኪ ኀበ ሕንፃ ሕይወት ተሐደሰ።","targetAnatomy":"ፍልሰተ ሥጋኪ","index":198,"lang":"gez"},{"type":"paragraph","text":"እምቅድመ ዝኒ ኀቤሁ ሥጋ ወልድኪ ፈለሰ።","targetAnatomy":"ማኅሌት","index":199,"lang":"gez"},{"type":"paragraph","text":"ቤዛዊተ ዓለም ማርያም አስተበቊዓኪ አንሰ።","targetAnatomy":"ማኅሌት","index":200,"lang":"gez"},{"type":"paragraph","text":"ትቤዝዊ በኪዳንኪ ዘዚኣየ ነፍሰ።","targetAnatomy":"ማኅሌት","index":201,"lang":"gez"},{"type":"paragraph","text":"እስመ በሥራይኪ ለቊስልየ ቀባዕክኒ ፈውሰ።","targetAnatomy":"ማኅሌት","index":202,"lang":"gez"},{"type":"paragraph","text":"ነአኲቶ ለእግዝአብሔር ለዘጸውዓነ በጽዋዔ።","targetAnatomy":"ማኅሌት","index":203,"lang":"gez"},{"type":"paragraph","text":"ተዝካረ ኪዳንኪ ንግበር ማዕከለ ምንዱባን ጉባዔ።","targetAnatomy":"ማኅሌት","index":204,"lang":"gez"},{"type":"paragraph","text":"ተመጠዊዮ ባሕቱ ማርያም አመ ትንሣኤ።","targetAnatomy":"ማኅሌት","index":205,"lang":"gez"},{"type":"paragraph","text":"ወአንብሪ በርእሰ ነፍሱ አክሊላተ መንግሥት ሱባዔ።","targetAnatomy":"ማኅሌት","index":206,"lang":"gez"},{"type":"paragraph","text":"ለነባቤ ዝንቱ ድርሳን አርብዓ ወክልኤ።","targetAnatomy":"ማኅሌት","index":207,"lang":"gez"},{"type":"paragraph","text":"ስብሐት ለኪ ማርያም በስብሐተ አብ ወላዲ።","targetAnatomy":"ማኅሌት","index":208,"lang":"gez"},{"type":"paragraph","text":"ስብሐት ለኪ ማርያም በስብሐተ ወልድ ተወላዲ።","targetAnatomy":"ማኅሌት","index":209,"lang":"gez"},{"type":"paragraph","text":"ስብሐት ለኪ ማርያም በስብሐተ መንፈስ ቅዱስ ኢተወላዲ።","targetAnatomy":"ማኅሌት","index":210,"lang":"gez"},{"type":"paragraph","text":"ተማኅፀንኩ በኪዳንኪ ለዓለመ ዓለም ወዓዲ።","targetAnatomy":"ማኅሌት","index":211,"lang":"gez"},{"type":"paragraph","text":"ከመ ትዕቀብኒ ወትረ እምሰይጣን ረዋዲ።","targetAnatomy":"ማኅሌት","index":212,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለኪ ኪዳነ ምሕረት ተስፋየ ዘታጸድቂ ኃጥአ።","targetAnatomy":"ኪ ኪዳነ","index":213,"lang":"gez"},{"type":"paragraph","text":"ወዘተኅሥሢ አሐደ በግዐ። ዘተገድፈ እምነ ተስዓ።","targetAnatomy":"ማኅሌት","index":214,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለኪ ኪዳነ ምሕረት ሐውልት ዘተከለኪ","targetAnatomy":"ኪ ኪዳነ","index":215,"lang":"gez"},{"type":"paragraph","text":"እግዚእ ትእምርተ አድኅኖ ትኩኒ ለኲሉ ኃጥእ።","targetAnatomy":"ማኅሌት","index":216,"lang":"gez"},{"type":"paragraph","text":"ፍቅረ ዘያጸንዕ","targetAnatomy":"ማኅሌት","index":217,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለኪ ኪዳነ ምሕረት ወርቅ መክብበ ኲሉ ንዋይ።","targetAnatomy":"ኪ ኪዳነ","index":218,"lang":"gez"},{"type":"paragraph","text":"አንቲ ውእቱ መዝገበ ነዳይ። ወብዕል ዘበሰማይ።","targetAnatomy":"ማኅሌት","index":219,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለኪ ኪዳነ ምሕረት በማይ ዘታጸንኒ መድሎተ።","targetAnatomy":"ኪ ኪዳነ","index":220,"lang":"gez"},{"type":"paragraph","text":"ተአምኖትየ ብኪ ረስዪ ሊተ፤ ገድለ ወትሩፋተ።","targetAnatomy":"ማኅሌት","index":221,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለኪ ሶበ ስእንኩ ጸዲቀ በምግባረ ሠናይ ወገድል።","targetAnatomy":"ኪ ሶበ","index":222,"lang":"gez"},{"type":"paragraph","text":"አስመኩ ብኪ ኪዳነ ድንግል መድኃኒተ ነፍስየ እምነ ኃጒል።","targetAnatomy":"ማኅሌት","index":223,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለኪ ኪዳነ ምሕረት ዐረቦነ መንግስት ዘላዕሉ።","targetAnatomy":"ኪ ኪዳነ","index":224,"lang":"gez"},{"type":"paragraph","text":"ዘያፈቅረኪ በተስፋ ይሄሉ።","targetAnatomy":"ማኅሌት","index":225,"lang":"gez"},{"type":"paragraph","text":"ሰላም ለኪ በከመ ኪዳንኪ ቤተ ለዘሐነፀ ገብርኪ ወለዘጸለየ","targetAnatomy":"ኪ በከመ","index":226,"lang":"gez"},{"type":"heading","text":"ማኅተም (ጸሎት)","level":2,"lang":"gez"},{"type":"prayer","text":"በስምኪ ማርያም ፈትቲ እምበረከትኪ ወሰአሊ ኀበ ኄር ወልድኪ።","lang":"gez"},{"type":"prayer","text":"ኦ እግዝእትየ ማርያም ዕቀብኒ ወአድኅንኒ በኪዳንኪ እምእደ ሰብእ እኩያን ወእምኃይለ አጋንንት ፀዋጋን ሊተ ለ .....................","lang":"gez"}]}]}