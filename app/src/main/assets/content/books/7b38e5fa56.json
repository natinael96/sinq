{
  "id": "7b38e5fa56",
  "title": "ሰቆቃወ ድንግል",
  "shelf": "zema",
  "chapters": [
    {
      "number": 1,
      "title": "ሰቆቃወ ድንግል",
      "blocks": [
        {
          "type": "heading",
          "text": "ሰቆቃወ ድንግል",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "(መግቢያ) በከመ ትቤ በወንጌል ኀበ ሀለዉ ክልኤቱ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ወሠለስቱ። ጉቡኣን በስምየ። እሄለ አንሰ ማዕከላሆሙ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ህየ። በእንተ ኪዳን ዘላዕላየ (ታ)አስተፊጥን ነዐ ተምኔትየ።",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ደብረ ቋስቋም ዘቦእከ ኢየሱስ አቡየ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "በስመ እግዘአብሓር ሥለስ ሕፀተ ግጻዌ ዘአልቦ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ሰቆቃወ ድንግል እጽሕፍ በቀለመ አንብዕ ወአንጠብጥቦ።",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ወይላ ወላህ ለይበል ዘአንበቦ። ከማሃ ኀዘን ወተሰድ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ሶበ በኳለሄ ረከቦ፡፡ ርእዮ ለይብኪ ዐይነ ልብ ዘቦ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "አይቴ ሀሎ ንጉሠ እስራኤል ዘተወልደ፡፡ ከመ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ነሀብ ሎቱ አምኃ ወሰጊደ፡፡ እንዘ ይብለ ሰብአ ሰገል",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ሰሚዕ ገሃደ። ሄሮድስ አሜሃ በእሳተ ቅንአት ነደ። ከመ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ይቅትለ ሕፃናተ ወኢያትርፈ አሏደ፡፡ እስከ ቤተ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ልሓም እምገሉላ ሏራሁ አዕደ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ጎየ ዮሴፍ ብሓረ ግብጽ ተንሢኦ እምንዋሙ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "መልአከ እግዘአብሓር ላሉተ በከመ ነገሮ በሕልሙ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ነሢኦ ሕፃነ ዘምስለ ማርያም እሙ፡፡ ይእቲ ትበኪ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ወትቤ ቀቲሎትየ ይቅድሙ፡፡ እምእርአይ ለወልድየ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ዘይትከዐው ደሙ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "አይቴ ኀለፈት እምዕያማ ማርያም ጣዕዋ።",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ኀሠሥክዋ በቤተ ልሓም ወኢረከብክዋ፡፡ እሴአለክሙ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ሰብአ ገሉላ እመ ርኢክምዋ፡፡ ንግሩኒ ዜናሃ ወአርእዩኒ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ፍናዋ፡፡ ኀበ ሕረት ላቲ በብካይ እትልዋ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ርኢክሙኑ፡ ወለተ ደክታመ፡፡ ሏዘላ ሕፃና እንዘ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ትጎይይ ገዳመ፡፡ አኀሥሠኪ ወእብል እንዘ አዐውድ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "አድያመ፡፡ ማርያም ጸዋሪተ ኀይል ዘኢለመድኪ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ድካመ፡፡ አንደደኒ ሥራህኪ ከዊኖ አፍሏመ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ርኢክሙኑ ነኣሰ መርዓተ፡፡ ሏዘላ ሕፃና እንዘ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ተሏልፍ ፍኖተ። አኀሥሠኪ እንዘ እብል እስከ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "እትከደን መሬተ፡፡ ማርያም ፈላሲተ ቋስቋም",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ዘኀጣእኪ ቤተ፡፡ አውዐየኒ ንግደትኪ ከዊኖ እሳተ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "አምሏልኩክን፡ በኀይለ ወበጽንዐ ለገዳም፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "አዋልደ ኢየሩሳላም፡፡ እመ ረከብካሃ ለማርያም",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "በደብረ ቋስቋም፡፡ ከመ ታይድዓሃ ብካየ ገብራ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ሕርቱም፡፡ ዘሀሎኩ ጽዐርየ በዓለም ሕሙም፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "አመ ዐረጉ በእግረ ኅሉናየ ውስተ ደብረ ቋስቋም",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ለይባቤ፡፡ ርኢኩ ድንግለ በፍኖት ዘሰለብዋ ግልባቤ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ሏዘላ ሕፃና ዘወለደት በኢሩካቤ፡፡ እምጻማ ወድካም",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "እንዘ ታስቆቁ ወትቤ፡፡ ንእስት አነ ዘኢለመድኩ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ምንዳቤ፡፡ ወልብየ ተሏውከኒ ከመ እብኪ ሶቤ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ምዕረ በዘባንኪ ወምዕረ በገቦኪ፡፡ ማርያም ብዝኀ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "በሏዘለ ሕፃን ደከምኪ፡፡ ሶበኒ የሏውር በእግሩ ከመ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ትጹሪዮ ይበኪ፡፡ አልቦ እንበለ ሰሎሜ ዘያስተባርየኪ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ለኪ፡፡ ወዮሴፍ አረጋዊ ዘይጸውር ስንቀኪ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "እምትካት አይሁድ በቅንአቶሙ ይጸልዐኪ ጥቀ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "በእንተ ዘወለድኪ በድንግልና ወልደ ጻድቀ፡፡ ሰደደኪ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "እምቤተ ልሓም እንበለ ታልህቂዮ ሕቀ፡፡ ለእደቅ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ብሓረ ባዕድ ከመ ኀደርኪ ውደቀ፡፡ ማርያም እንግዳ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ዘአልብኪ ዐውቀ፡፡ ዘይትዌከፈኪ ወይሁበኪ አሏተ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ጸሪቀ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "እፍ ቈቋዐ በሏዊረ ፍኖት መከየደ እግርኪ ወርኀ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ዘይሴአን። ለባሲተ ፀሒይ ማርያም ወለተ ብርሃን።",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "አመ አጕየይኪ ወልደኪ በጕጕዓ እምገጸ ሄሮድስ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ተመን፡፡ ዘበጽሐኪ ምንዳቤያተ ሶበ ይሰምዕ በእዛን፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ሰብእ አኮ እምበከየ እብን፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "እፍኑመ የብሳ አጥባትኪ ሏመልማለ ገነት ሄላ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ድንግልናዌ ሏሉበ ውስተ አፈ ሕፃን ዘአፈልፈላ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ለአይ ከማኪ በሏሩረ ፀሒይ ዘቈላ፡፡ ማርያም ጽጌ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ደንጎላ ዘድማኅየ ቀጸላ፡፡ በማዕከለ አሥዋክ ወአሜከላ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ዘሏንበብኪ ተድላ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "እፍ ጎየይኪ እምፍርሀተ ቀትል እምገጸ ሄሮድስ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ቋንጽል፡፡ ወለተ አናብስት ግሩማን እለ ይጥኅሩ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "በኀይል። ኢፈቀድኪዮ በምድር ለመንግሥተ ዓለም",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ወብዕል፡፡ እስመ ልማደ ትሕትና ለፍሬ ከርሥኪ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ልዐል፡፡ ከማሁ ግዕዛኪ በምግባር ወቃል፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ኢየሱስ ስደድ ተስፊሆሙ ለስደዳን፡፡ ኢየሱስ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ግፈዕ ምስካየ ግፈዓን፡፡ እግዘአብሓር ማኅደር ዘአልቦ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ከመ ነዳያን፡፡ ኢየሱስ ነግድ ወፈላሲ እንዘ ውእቱ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ሕፃን፡፡ ወልደ አብ ፍቁር በኀበ ሰብእ ምኑን፡፡ መሒልየ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ብካይ ኮነኒ ዘእሙ ኀዘን፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "በደመና ሥጋ ተፅዑኖ ከመ ዘኢየአምር ነሶሳወ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "እንዘ ይወርድ ውስተ ምድረ ግብጽ ደኪሞ ሀፈወ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ወሥነ ከናፍሪሁ ጽጌ በሏሩረ ፀሒይ መጽለወ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ለጠቢው ሶበ ፈተወ አጥባተ እሙ ምንትወ፡፡ ኀጢኦ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ሏሉበ ከመ ሕፃናት ለሏወ፡፡ ህየንተ አንብዐ ለወልድ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ለእኩን ክዕወ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "አይቴ ይእቲ ሏና እምየ፡፡ ወኤልሳቤጥኒ እንተ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "እምአዛማድየ፡፡ ይብክያኒ ሉተ በእንተ ንግደትየ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ለሀወት ማርያም እንዘ ትብል ወይ ልየ፡፡ ዘየአምረኒ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ሉተ ኀጣእኩ በዛየ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ተንሥኢ ወንዑ ላዋዊት ሏና፡፡ ትጼውዐኪ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ወለትኪ ከመ ትርአዪ ኀዘና፡፡ እምርስትኪ ወፅአት",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ወተሰደት በድክትምና፡፡ ትበኪ እምዋዕየ ሏጋይ ኀጢኣ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "በፍና፡፡ ሕፍነ ማይ ዘታሰትዮ ለጽሙዕ ሕፃና፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "መኑ ይሁበኒ ዘኤርምያስ ቃለ፡፡ በእንተ ማርያም",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "አስቆቁ ወእንግር አምሳለ፡፡ ልሳነ ሏፃኒት የብሰ በከመ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ተብህለ፡፡ ጕርዓሃኒ በጽምዕ በሰለ፡፡ ሶበ ርኅቡ ዕጎሉሃ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ሰአልዋ ስኢለ፡፡ ወኀጥአት ሎሙ ዘትሁቦሙ እክለ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "መለኮታዊ ዕጓላ ሶበ ጸምአ ከመ ደቂቅ፡፡ ዘይሰፍሮ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "በሕፍኑ ለማየ ባሕር ዕሙቅ፡፡ በከየት ወትቤ ማርያም",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ማዕነቅ፡፡ እምሰብአ ሀገር አልቦ ዘየአምራ ለጽድቅ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ሰአልክዎሙ ማየ ኢወሀቡኒ በሕቅ፡፡ ወአኅጎልኩ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ለወልድየ አሣእኖ ዘወርቅ።",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ሰሚዕ ሕፃን ለእሙ ገዐራ፡፡ ባረከ ኰኳሏ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ወአንቅዐ ማየ እምታሕተ እግራ፡፡ ወእምኔሁ ለጽምኣ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ትስተይ አመራ፡፡ ከመ ኢይስተይዋ ሰብአ ሀገር ለይእቲ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ማይ አምረራ፡፡ ወለርሐቃን ፈውሰ ወጥዕምተ ገብራ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "በቤተ መቅደስ ዘልህቀት ወለተ ካህናት እንዘ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ትሴሰይ ሥሩ|ዐ፡፡ ኅብስተ ሰማይ ኅቡዐ ወጽዋዐ ወይን",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ምለአ፡፡ እፍ ከመ ነዳይ ሲሳየ ዕለት ዘኀጥአ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ተዐገሠት በብሓረ ግብጽ ረኀበ ወጽምአ፡፡ አልቦ ከማሃ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ዘረከበ ግፍዐ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ያዕቆብ ነገደ በፍሥሒ ለረኪበ ኳለ መፍቅደ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ሶበ ሰምዐ በብሓረ ግብጽ ከመ ነግሠ ወልደ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ለአጕይዮ ወልዳ በአንብዕ አመ ሕፃናት ተኀርደ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ነገደት ውስተ ምድረ ግብጽ ማርያም ዘመደ፡፡ ኀበ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "አልባቲ ዘየአምራ ወኢ፩ደ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ብክዩ ኅዝናን ኀልየክሙ ስደታ፡፡ ወላህዉ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ፍሡሒን ተዘኪረክሙ ብዛኀ ሠናይታ፡፡ ማርያም",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ተዐይል ከመ ዕፍ ውስተ አድባረ ግብጽ ባሕቲታ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ተአወዩ በኀጢኦታ ሀገረ አቡሃ ኤፍራታ፡፡ ወደመ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ሕፃናት ይውኅዛ በኳለ ፍኖታ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "አይቴኑ መልአክ ዘአብሠረኒ፡፡ ብካይየ ይርአይ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ወይርድአኒ፡፡ ወአልብየ ሰብእ ዘየአምረኒ፡፡ እንዘ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ትብሉ ድንግል አራኅራኅክኒ፡፡ በገዳም አመ ነሥኡኪ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ልብሰ ወልድኪ ረቡኒ፡፡ ጸላዑ ወተቃራኒ ፈያታይ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ማኅዘኒ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ኀበ አዕረፍኪ እግዛእትየ ማርያም (ኀበ አዕረፍኪ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "እግዛእትየ) ታሕተ ጽላሎተ ዕፅ እምጻማ፡፡ ፈያት ፪ቱ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ሶበ በጽሐኪ በግርማ፡፡ እምትሕዛብተ ሞቱ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ማሕመሚ ለወልድኪ ንጉሠ ራማ፡፡ እፍኑመ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "አዕይንትኪ ማያተ አንብዕ አዛነማ፡፡ አዕይንትየ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ለገብርኪ ፪ኤሆን ይጽለማ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ይጽብበኒ እግዛእትየ ማርያም (ይጽብበኒ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "እግዛእትየ) ከመ ጸበበኪ ዓለም በምልኡ፡፡ አመ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ዐገቱኪ ፈያት ልብሰ ወልድኪ ይንሥኡ፡፡ ዐይንኪ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ዘርግብ ነጸፍጻፈ አንብዕ ይክዐ፡፡ ነጺሮ ዕርቃኖ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ለሕፃንኪ በግዐ፡፡ እስከነ አግብአ ለኪ አሏደ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "እምካልኡ፡፡ እንዘ ያነክር እምጼና ልብሱ ወአዳም",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "መልክዐ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ሚ ዕፁብ ብዛኀ ትሕትናኪ ማርያም እግዛእትየ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ምስለ ወልድኪ ባዕል ዘገብረ ሰማየ፡፡ ውስተ ደብረ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ቋስቋም ኀደርኪ ተመሲለኪ ነዳየ፡፡ ኢረከብኪ ሰብአ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "በህየ ዘይሁበኪ ሲሳየ፡፡ ወእመ አኮ ለጽምእኪ ማየ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "መኑ ይነግረከ ወይዜንወከ ዜናዊ፡፡ ገዐረ ወለትከ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ትስማዕ ኢያቄም ፳ኤላዊ፡፡ እምቤተ ሙላዳ ወፂኣ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ዘምስለ ሕፃና ጠባዊ፡፡ ትበኪ እንከ ወትቤ ንግሥተ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ይሁዳ ወላዊ፡፡ ውስተ ናሕሰ ቋስቋም ኀደርኩ ከመ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ዕፍ ባሕታዊ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ነዐ ኤርምያስ እምአናቶት ለወለተ ነቢያት",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ታስቆቅዋ፡፡ በኀጢአ አብያት ዘተኀድር ለቋስቋም",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "በውስተ በድዋ፡፡ ወበል አክይስት ዕጎሉሆን አጥበዋ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ሉተሰ አዋልደ ሕዛብየ ፄዋ፡፡ ከመ ሰገኖን በገዳም",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ሀለዋ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ስጥጥ ልብሰከ እስራኤል ወቅንት ሰቀ፡፡ በከመ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ለሀውኮ ለዮሴፍ አመ ኀጣእኮ ጥዩቀ፡፡ ለወለትከ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ትብክያ ምሳላ ነገር አልጸቀ፡፡ ወዳዊት በእንተ ድካማ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ያስቆቁ ጽፈቀ፡፡ እንዘ ይብል ሰይ ልየ ማኅደርየ ርሕቀ።",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "አመ ፈነወ ሄሮድስ ወዓሉሁ ውስተ ደብረ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ቋስቋም ይኅሥሣ፡፡ ሰሚዓ ድንቀተ እምቃለ ወልደ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ዮሴፍ ዮሳ፡፡ ማርያም ደንገፀት ወተሏውከ ውሳጤ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ከርሣ፡፡ እምእደ ሰሎሜ አሜሃ ተመጠወቶ ለሮሳ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ከመ ትብክዮ አቈራ በልብሳ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ኢደከምኩኑ በሥራኅ ወበገዐር፡፡ እንዘ አጎይየከ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ወትረ እምሀገር ለሀገር፡፡ ባሕታዊት እምከ ይእዜ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "አይቴኑ አሏውር፡፡ በጣዕመ ቃላ መዓርዑር",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ወበአስቆቅዎ መሪር። ማርያም ትቤሎ ለወልዳ ፍቁር።",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ምንተ እከውን በኀጢአ ዘአከ ሶበ እሬኢ አነ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "እንዘ ያጠብዋ አንስት እለ ወለዳ ሕፃነ፡፡ ፍቁርየ ነጽር",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ዘረከበኒ ኀዘነ፡፡ ከመ ይበጽሏከ ሄሮድስ እመ አእመርኩ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "አነ፡፡ እምአጕየይኩከ እምዛ ርሐቀ መካነ፡፡ ማርያም",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ትቤሎ ለወልዳ እሙነ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ቦኑ ለከንቱ ዘሮጽኩ ወጻመውኩ፡፡ እምሄሮድስ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ነዓዊ እመ ኢያምሰጥኩ። ወለምንት ዛየ እምሀገርየ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ወፃእኩ። ወለተ ዳዊት ትቤ ዘይናዛዘኒ ኀጣእኩ።",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ትክዛትየ ዘልፈ በኳለ ነበርኩ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "እንዘ ታንጌጊ ከመዛ አባላቲሁ በስዑም፡፡ ሶበ ነጸራ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ሕፃን ለወላዲቱ ማርያም። ውሑዘ አንብዓ ኀሠሠ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "በአፅባዕተ እደ ልምለም፡፡ ናዘዙ ወይቤላ በቃለ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ጥዐም፡፡ ኢይረክበኒ ሉተ እድወ ደመ ርጉም፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "በእንቲአየ ኢትብክዪ እም፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ምዕረ ትትፋሣሕ ሶበ ተኀ ዛን ለሕፃን ወላዲቱ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ርእያ ዘይገብር ተአምረ ውስተ አድባረ ግብጽ አመ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "በኣቱ፡፡ አንፈርዐፁ አድባር ወሰገደ ሎቱ፡፡ ወአመ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "አጽዐቅዎ ዓዲ እንዘ የኀልፍ በፍኖቱ፡፡ አእባነ ረሰዮሙ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ለአግማል ኀምስቱ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "አሏደ ሕፃን እምዕብራውያን ማዕድተ ተከዘ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ተገዲፍ፡፡ ወእምተሰጥሞ ውስተ ባሕር በእደ ወለተ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ፈርዕን ተሏዲፍ፡፡ አውፅአ ሕዛበ እምድረ ግብጽ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ወለፀሮሙ ቀሰፍ፡፡ ሕፃነ ማርያም ከማሁ እምሕፃናተ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ገሉላ ተሪፍ፡፡ ፄዋ ጽዮን ሜጠ ወነሠተ ግልፍ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ኀበ ኀፀበት በማይ አልባሲሁ ወዓባሎ፡፡ ለሕፃነ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ድንግል ዛኩ ሰሎሜ ዘተኀዛሎ፡፡ በለሳነ ኮነ ሀፈ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ሥጋሁ በቈሎ። ሜሮን ቅብዕ ዘይቄድስ ኳሎ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ለትእምርት በኀቤነ እስከ ዮም ሀሎ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ታቦተ አምላከ እስራኤል ጽዮን ማርያም ዘነገደት",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ምድረ ኢሎፍሉ፡፡ ወቀጥቀጠቶ ለዳጎን ነፍሳተ ብዝኃን",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ማህጎሉ፡፡ አመ ነገደት ቋስቋመ በኀይለ ወልዳ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ከሃሉ፡፡ ወድቁ አማልክተ ግብጽ መናብርተ ሰይጣን",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ሀባሉ፡፡ ወተኀፍሩ ኳሎሙ ዘቦሙ አስጋሉ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "መኑ ይሁበኒ ክንፈ ከመ ዕፍ፡፡ ውስተ ደብረ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ቋስቋም እሥርር ወአምሥጥ እምጸድፍ፡፡ ብእሲተ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ሰማይ ማርያም በከመ ጽሐፍ፡፡ ኀበ አምሰጠት በህየ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "እመሥገርተ አርዌ ጽሩፍ፡፡ ወኀበ አዕረፈት ባቲ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "እምጻማ ድካም ወሀፍ። እንዘ በሕፅና መለኮት ሕቁፍ።",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ብፅዕት ዐይን ዘርእየቶ ለብለየ መዋዕል አምላክ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ከመ እንተ ሕፃን ንኡስ ተሏቂፍ በአብራክ፡፡ ወእምዛ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ወሪድ ውስተ መራሕብት እንዘ ይድሕክ። ቡርክት",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "አንቲ ማርያም ወፍሬ ከርሥኪ ቡሩክ፡፡ በከመ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ይቤለኪ በብስራቱ ገብርኤል መልአክ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ሶበ ሀሎኩ በጕየቱ ውእተ መዋዕለ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "እምተመነይኩ ኪያሁ በዘባንየ ሏዘለ፡፡ ወበልሳንየ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "እልሏስ ዘአእጋሪሁ ጸበለ፡፡ ወእስዓም በአፈየ አሠረ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "እዳሁ በኰኳሕ ዘተሥዕለ፡፡ ወከመ አዕርፍ ምስላሁ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "በትረ ዮሴፍ ኀበ ተተክለ። ለወልደ ማርያም በሏፀ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ፍቅሩ ልቡናየ ቈስለ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ለምንት ሄሮድስ ለወልደ ዳዊት ከመ ይቅትሎ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ዘኀሠሦ፡፡ እስመ መሰሎ በቅንአት ዘይወርስ ንግሦ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ስእነት እሙ አጕያዪቱ እምብካይ ተዐግሦ፡፡ በደብረ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ቋስቋም እንዘ ትስዕም ርእሶ፡፡ ፈያትኒ አመ ነሥኡ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ልብሶ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ለምንት በከይኪ እግዛእትየ እምጻማ ፍኖት",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ወሥራሕ፡፡ አመ ወረድኪ ውስተ ምድረ ግብጽ ምስለ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ወልድኪ ፍሡሕ፡፡ እንዘ አንቲ ሥርጉት በቅድስና",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ወንጽሕ፡፡ ሉተሰ ለርሱሕ ይደልወኒ በፍትሕ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ይርከበኒ እምኔኪ ዘየዐቢ ላህ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ለምንት ነገድኪ እግዛእትየ እምርስተ አቡኪ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "በአንብዕ። ውስተ ብሓረ ሕዛብ ካልእ ምስለ ወልድኪ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ባቋዕ፡፡ ዘይፈትሕ ጽድቀ ለኳለ ግፈዕ፡፡ ሉተሰ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ለኀጥእ ይደልወኒ በርትዕ፡፡ ዘከማኪ ተአንግድ በረኃብ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ወጽምእ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ስፍነ እዜኑ እግዛእትየ ዘረከቡኪ በፍኖት፡፡ ዋዕየ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ፀሒይ ዘመዓልት ወቋረ ገዳም ዘላሉት። ወምስለ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ዛንቱ ኳለ አመንደቡኪ ፈያት። ገብርኪሰ ሶበ ሀሎኩ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "በውእቶን ዓመታት፡፡ እምፈተውኩ ይርከበኒ ከማኪ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ስደት፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ተመየጢ እግዛእትየ ማርያም (ተመየጢ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "እግዛእትየ) ሀገረኪ ናዛሬተ። ወኢትጎንድዪ በግብጽ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ከመ ዘአልብኪ ቤተ፡፡ በላዕላኪ አልቦ እንተ ያመጽእ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ሁከተ፡፡ ለወልድኪ ዘየኀሥሦ ይእዜሰ ሞተ፡፡ በከመ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ነገሮ መልአክ ለዮሴፍ ብሥራተ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "እስከ ማእዜኑ እግዛእትየ ማርያም (እስከ ማእዜኑ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "እግዛእትየ) ውስተ ምድረ ነኪር ትሄልዊ፡፡ ሀገረኪ ናሁ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ገሉላ እትዊ፡፡ ለወልድኪ ሕፃን ዘስሙ ናዛራዊ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ለክብረ ቅደሳን በከመ ይቤ ዕዛያን ዜናዊ፡፡ እምግብጽ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ይጼውዕ አቡሁ ራማዊ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ወተመይጠት ማርያም ሀገረ እስራኤል አቡሃ። ነቢራ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "በግብፅ አርብዓ ወ፪ተ አውራኀ፡፡ ይስግዳ ላቲ አዋልደ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ጢሮስ በአምኃ፡፡ እምይእዜሰ ነገፍኩ ላሀ፡፡ ለእምየ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "በእትወታ ረኪብየ ፍሥሒ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "አብርሂ አብርሂ ናዛሬት ሀገሩ፡፡ ንጉሥኪ በጽሏ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ዘምስለ ማርያም መጾሩ፡፡ ጣዕታተ ግብፅ ኳለ ቀጥቂጦ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "በበትሩ፡፡ ይጕየዩ ወይትኀፈሩ ሠራዊተ ሄሮድስ ፀሩ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ዘበላዕላሁ እኩየ መከሩ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ሏለየት ማሕላተ እኅተ ሙሴ በከበሮ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ወበመዛሙር፡፡ በእንተ ስጥመቱ ለፈርዕን ወፀአተ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ሕዛባ እምባሕር። እንዘ ትብል ይትነከር",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "እግዘአብሓር። በእንተ ሕይወታ ለማርያም ወድቀተ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ፀራ ነኪር። ተፈሥሐ ሰማያት ወተኀሥየት ምድር፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ወለተ ዳዊት በሉ እንዘ ትነግሪ ዘእግዘአብሓር",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "አድኅኖ፡፡ ርኢክዎ ለኃጥእ ዐብየ ወተለዐለ ከመ አርዘ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ሉባኖስ ከዊኖ፡፡ ኀሠሥክዎ በግብአትየ ወኢረከብኩ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "መካኖ፡፡ እስመ ሰበረ ወልድየ ለሄሮድስ ቀርኖ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "(ዘኅብረት) ሶበ ኀለይኩ ፍልሰትየ ርሐቀ ብሓረ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ወሐረትየ እምዛ ኀበ ኢይገብእ ድኅረ፡፡ ብካየ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ንግደትኪ ድንግል ኮነኒ መዛሙረ፡፡ ረስዪኒ ወትረ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ማርያም ውስተ አፈኪ ዛኩረ። በኅሉናኪ ህልወ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ወበልብኪ ኅደረ፡፡ እስመ ዘእንበላኪ ባዕድ አልብየ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ማእምረ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ስብሏት ለኪ ማርያም በስብሏተ አብ ፈናዊ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ስብሏት ለኪ ማርያም በስብሏተ ወልድ ተፈናዊ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ስብሏት ለኪ ማርያም በስብሏተ መንፈስ ቅደስ",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ማሕየዊ፡፡ ቃለ ስእለትነ በአእዙነ መንፈስ ጽልዊ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ወዲበ ዙቲ ማሕላት ሰላመ ከዐዊ፡፡",
          "lang": "gez"
        },
        {
          "type": "paragraph",
          "text": "ለአግብርትኪ ወለአእማትኪ ሕዛበ ክርስቲያን፡፡",
          "lang": "gez"
        }
      ]
    }
  ]
}