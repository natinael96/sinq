            "chants": [
              {
                "form": "መመሪያ",
                "text": "ስምዓኒ እግዚኦ ጸሎትየ፡ ሃሌ ሉያ ሃሌ ሉያ፡ ወይብጻሕ ቅድሜከ ገአርየ፡ ሃሌ ሉያ ሃሌ ሉያ፡ ወኢትሚጥ ገጸከ እምኔየ፡ በዕለተ ምንዳቤየ አጽምእ እዝነከ ኀቤየ፡ ሃሌ ሉያ ሃሌ ሉያ፡ አመ ዕለተ እጼውአከ ፍጡነ ስምዓኒ፡ ሃሌ ሉያ ሃሌ ሉያ፡ ለዓለም ወለዓለመ ዓለም፡ ሃሌ ሉያ ዘውእቱ ብሂል፡ ንወድሶ ለዘሃሎ እግዚአብሔር ልዑል፡ ስቡሕ ወውዱስ ዘሣረረ ኵሎ ዓለመ፡ በአሐቲ ቃል።",
                "source_blocks": [
                  8,
                  9
                ],
                "title": "(ሥርዓተ ነግሥ )",
                "id": "b12-8"
              },
              {
                "form": "መልክእ",
                "text": "ሰላም ለመታክፍቲክሙ መሠረተ ዓለም እለ ፆሩ ኖትያተ ኖኅ ሥላሴ ወዕፀወ ዐባይ ሐመሩ ዲበ መንበርክሙ ሰብአ ሶበ አምላክ ነጸሩ ኪሩቤል ወሱራፌል ታህተ እገሪሁ ገረሩ እስመ ለሊሁ አዘዘ ወእሉ ተፈጥሩ፡፡",
                "source_blocks": [
                  10,
                  11
                ],
                "title": "መልክአ ሥላሴ",
                "id": "b12-10"
              },
              {
                "form": "ዚቅ",
                "text": "እሉ ኪሩቤል ወሱራፌል የዐርጉ ሎቱ ስብሐተ እንዘ ይብሉ ቅዱስ ቅዱስ ቅዱስ አንተ እግዚአብሔር አብ ወወልድ ወመንፈስ ቅዱስ።",
                "source_blocks": [
                  12,
                  13
                ],
                "id": "b12-12"
              },
              {
                "form": "ነግሥ",
                "text": "ሰላም ለክሙ ሚካኤል ወገብርኤል ሱራፌል ወኪሩቤል ዑራኤል ወሩፋኤል ሱርያል ወፋኑኤል አፍኒን ወራጉኤል ወሳቁኤል ሊቃናተ ነድ ዘሰማያዊት ማኅፈድ በእንተ በግዑ ዕቀብዋ ለዛቲ አፀድ።",
                "source_blocks": [
                  14,
                  15
                ],
                "id": "b12-14"
              },
              {
                "form": "ወረብ",
                "text": "ለዛቲ አፀድ በእንተ በግዑ ዕቀብዋ ለዛቲ አፀድ /፪/\nሊቃናተ ነድ ሊቃናተ ነድ ነድ ሊቃናተ ነድ /፪/",
                "source_blocks": [
                  16,
                  17,
                  18
                ],
                "id": "b12-16"
              },
              {
                "form": "ዚቅ",
                "text": "መላእክተ ምሕረት እለ ድልዋን ለሣህል ሰአሉ አስተምሕሩ ለነ እስመ በጸሎተ ትንብልናክሙ ትድኅን ወኢትማስን ሀገር።",
                "source_blocks": [
                  19,
                  20
                ],
                "id": "b12-19"
              },
              {
                "form": "መልክእ",
                "text": "ሰላም ለአእናፊከ መዓዛ አርያም እለ ተመልዑ ሱራፌል ምስሌከ አመ ይሠውዑ ሚካኤል አንተ ለያዕቆብ ኖላዌ ዘርዑ በሎሙ ለአብያጺከ ለሐውፆ አርክየ ንዑ እስመ በአሐዱ ፍቁር ይሰሐብ ካልዑ፡፡",
