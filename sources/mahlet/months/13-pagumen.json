              {
                "form": "ዚቅ",
                "text": "ሩፋኤል ግሩም በመንፈስ ቅዱስ ሕቱም መዓዛ ቅዳሴከ ጥዑም ከመ ጽጌ ገዳም ነዓ ነዓ ማዕከሌነ ቁም በበዓልከ ባርከነ ዮም።",
                "source_blocks": [
